<UserControl x:Class="Crown__.Frontend.Controls.KpiCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource HotelSansFont}"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <!-- Tarjeta de indicador reutilizable: título, valor y pista inferior. -->
    <Border Style="{StaticResource Card}" Padding="16,14">
        <StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtTitulo" Style="{StaticResource EyebrowText}" FontWeight="Medium" VerticalAlignment="Center" AutomationProperties.Name="Indicador" />
                <Border Grid.Column="1" Background="{DynamicResource UI.Inset}" CornerRadius="7" Width="28" Height="28" Margin="6,0,0,0">
                    <Path x:Name="MetricGlyph" Data="M2,16 V9 H6 V16 M9,16 V4 H13 V16 M16,16 V1 H20 V16" Stroke="{DynamicResource UI.Muted}" StrokeThickness="1.4" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
            <TextBlock x:Name="TxtValor" Style="{StaticResource KpiValue}" FontSize="30" FontWeight="SemiBold" Text="—" Margin="0,8,0,0" />
            <TextBlock x:Name="TxtPista" Style="{StaticResource MutedText}" Text=" " Margin="0,4,0,0" />
        </StackPanel>
    </Border>
</UserControl>
