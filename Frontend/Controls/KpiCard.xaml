<UserControl x:Class="Crown__.Frontend.Controls.KpiCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource HotelSansFont}"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <!-- Tarjeta de indicador reutilizable: título, valor y pista inferior. -->
    <Border Style="{StaticResource Card}" Padding="16,14">
        <StackPanel>
            <TextBlock x:Name="TxtTitulo" Style="{StaticResource EyebrowText}"
                       AutomationProperties.Name="Indicador" />
            <TextBlock x:Name="TxtValor" Style="{StaticResource KpiValue}" Text="—" Margin="0,6,0,0" />
            <TextBlock x:Name="TxtPista" Style="{StaticResource MutedText}" Text=" " Margin="0,4,0,0" />
        </StackPanel>
    </Border>
</UserControl>
