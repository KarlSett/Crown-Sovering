<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Crown__.Frontend.Controls"
                    xmlns:theme="clr-namespace:Crown__.Frontend.Themes">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Themes/HotelPalette.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Texto -->
    <Style x:Key="StrongText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource UI.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Dark">
                <Setter Property="Foreground" Value="{DynamicResource UI.Text}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource UI.Muted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Dark">
                <Setter Property="Foreground" Value="{DynamicResource UI.Muted}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="EyebrowText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource UI.Muted}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Dark">
                <Setter Property="Foreground" Value="{DynamicResource UI.Muted}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HotelSansFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource UI.Text}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Dark">
                <Setter Property="Foreground" Value="{DynamicResource UI.Text}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="KpiValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource UI.Text}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Dark">
                <Setter Property="Foreground" Value="{DynamicResource UI.Text}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Tarjetas -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource UI.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UI.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18,16" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Dark">
                <Setter Property="Background" Value="{DynamicResource UI.Surface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource UI.Border}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Navegación lateral -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource UI.SidebarText}" />
        <Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="RadioButton">
                <Grid>
                    <Border x:Name="Surface" CornerRadius="8" Background="Transparent" Padding="11,11">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="19" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path x:Name="Glyph" Data="M2,2 H18 V18 H2 Z" Width="17" Height="17" Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.45" StrokeLineJoin="Round" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="{TemplateBinding Content}" TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                    <Border x:Name="Focus" BorderThickness="1" BorderBrush="{DynamicResource UI.BrandMark}" CornerRadius="7" Margin="1" Visibility="Collapsed" IsHitTestVisible="False" />
                </Grid>
                <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="funcionamiento"><Setter TargetName="Glyph" Property="Data" Value="M2,2 H8 V8 H2 Z M12,2 H18 V8 H12 Z M2,12 H8 V18 H2 Z M12,12 H18 V18 H12 Z" /></Trigger>
                        <Trigger Property="Tag" Value="reservas"><Setter TargetName="Glyph" Property="Data" Value="M3,4 H17 V18 H3 Z M3,8 H17 M7,1 V6 M13,1 V6 M7,12 H10 M7,15 H13" /></Trigger>
                        <Trigger Property="Tag" Value="habitaciones"><Setter TargetName="Glyph" Property="Data" Value="M2,6 V18 M2,14 H18 V18 M3,10 H16 Q18,10 18,13 V14 M5,6 H10 V10 H5 Z" /></Trigger>
                        <Trigger Property="Tag" Value="ingresos"><Setter TargetName="Glyph" Property="Data" Value="M3,17 V11 H6 V17 M9,17 V7 H12 V17 M15,17 V2 H18 V17 M1,19 H20" /></Trigger>
                        <Trigger Property="Tag" Value="huespedes"><Setter TargetName="Glyph" Property="Data" Value="M13,6 A3,3 0 1 1 7,6 A3,3 0 1 1 13,6 M4,18 V15 Q4,11 10,11 Q16,11 16,15 V18 Z" /></Trigger>
                        <Trigger Property="Tag" Value="inventario"><Setter TargetName="Glyph" Property="Data" Value="M4,2 H16 V19 H4 Z M7,5 H9 M12,5 H14 M7,9 H9 M12,9 H14 M7,13 H9 M12,13 H14 M9,19 V16 H12 V19" /></Trigger>
                        <Trigger Property="Tag" Value="estancias"><Setter TargetName="Glyph" Property="Data" Value="M8,5 A4,4 0 1 1 2,10 A4,4 0 0 1 8,5 M9,11 L17,19 M13,15 L16,12 M16,18 L19,15" /></Trigger>
                        <Trigger Property="Tag" Value="facturacion"><Setter TargetName="Glyph" Property="Data" Value="M5,2 H16 V19 L13,17 10,19 7,17 5,19 Z M8,6 H13 M8,10 H13 M8,14 H11" /></Trigger>
                        <Trigger Property="Tag" Value="pagos"><Setter TargetName="Glyph" Property="Data" Value="M2,4 H18 V17 H2 Z M2,8 H18 M5,13 H9" /></Trigger>
                        <Trigger Property="Tag" Value="reservasadmin"><Setter TargetName="Glyph" Property="Data" Value="M2,4 H18 V18 H2 Z M2,8 H18 M6,1 V6 M14,1 V6 M7,12 L10,15 15,10" /></Trigger>
                        <Trigger Property="Tag" Value="notificaciones"><Setter TargetName="Glyph" Property="Data" Value="M4,14 H16 L14,11 V7 A4,4 0 0 0 6,7 V11 Z M8,17 Q10,20 12,17" /></Trigger>
                        <Trigger Property="Tag" Value="convenios"><Setter TargetName="Glyph" Property="Data" Value="M2,8 L7,4 11,7 15,4 19,8 14,17 9,15 6,17 Z M7,4 L5,10 10,14 14,10" /></Trigger>
                        <Trigger Property="Tag" Value="limpieza"><Setter TargetName="Glyph" Property="Data" Value="M13,2 L7,12 M6,10 L13,14 10,19 2,15 Z M15,4 H19 M17,2 V6" /></Trigger>
                        <Trigger Property="Tag" Value="consumos"><Setter TargetName="Glyph" Property="Data" Value="M3,10 H17 M5,10 V8 A5,5 0 0 1 15,8 V10 M2,14 H18 M3,17 H17 M10,1 V3" /></Trigger>
                        <Trigger Property="Tag" Value="configuracion"><Setter TargetName="Glyph" Property="Data" Value="M2,5 H18 M2,15 H18 M6,2 V8 M14,12 V18" /></Trigger>
                        <Trigger Property="Tag" Value="seguridad"><Setter TargetName="Glyph" Property="Data" Value="M10,1 L18,4 V10 Q18,16 10,20 Q2,16 2,10 V4 Z M6,10 L9,13 14,7" /></Trigger>
                        <Trigger Property="Tag" Value="tarifas"><Setter TargetName="Glyph" Property="Data" Value="M3,3 H11 L19,11 11,19 3,11 Z M8,7 A1,1 0 1 1 6,7 A1,1 0 1 1 8,7" /></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource UI.SidebarHover}" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource UI.SidebarActive}" /><Setter Property="Foreground" Value="{DynamicResource UI.OnSidebarActive}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>

    <!-- Botones compactos -->
    <Style x:Key="PeriodOption" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource UI.Muted}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Surface" CornerRadius="9" Padding="14,8" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#14D9BB79" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource UI.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource UI.OnAccent}" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Dark" />
                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource UI.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource UI.OnAccent}" />
                        </MultiDataTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource UI.Accent}" />
                            <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CompactButton" TargetType="Button">
        <Setter Property="theme:ThemePresentation.SmoothHover" Value="True" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Button">
                <Grid>
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                            <Path x:Name="ActionGlyph" Data="M1,7 H13 M7,1 V13" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" Width="14" Height="14" Margin="0,0,8,0" Visibility="Collapsed" Stretch="Uniform" />
                            <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="Hover" Background="{TemplateBinding Foreground}" Opacity="0" CornerRadius="7" IsHitTestVisible="False" />
                    <Border x:Name="Focus" BorderBrush="{DynamicResource UI.Focus}" BorderThickness="2" CornerRadius="9" Margin="-2" Visibility="Collapsed" IsHitTestVisible="False" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="Content" Value="Nueva reserva"><Setter TargetName="ActionGlyph" Property="Visibility" Value="Visible" /></Trigger>
                    <Trigger Property="Content" Value="Nueva habitación"><Setter TargetName="ActionGlyph" Property="Visibility" Value="Visible" /></Trigger>
                    <Trigger Property="Content" Value="Nuevo huésped"><Setter TargetName="ActionGlyph" Property="Visibility" Value="Visible" /></Trigger>
                    <Trigger Property="Content" Value="Guardar"><Setter TargetName="ActionGlyph" Property="Visibility" Value="Visible" /><Setter TargetName="ActionGlyph" Property="Data" Value="M1,7 L5,11 13,2" /></Trigger>
                    <Trigger Property="Content" Value="Guardar reserva"><Setter TargetName="ActionGlyph" Property="Visibility" Value="Visible" /><Setter TargetName="ActionGlyph" Property="Data" Value="M1,7 L5,11 13,2" /></Trigger>
                    <Trigger Property="Content" Value="Buscar"><Setter TargetName="ActionGlyph" Property="Visibility" Value="Visible" /><Setter TargetName="ActionGlyph" Property="Data" Value="M10,5 A4,4 0 1 1 2,5 A4,4 0 1 1 10,5 M9,9 L14,14" /></Trigger>
                    <Trigger Property="Content" Value="Buscar disponibilidad"><Setter TargetName="ActionGlyph" Property="Visibility" Value="Visible" /><Setter TargetName="ActionGlyph" Property="Data" Value="M10,5 A4,4 0 1 1 2,5 A4,4 0 1 1 10,5 M9,9 L14,14" /></Trigger>
                    <Trigger Property="Content" Value="Actualizar"><Setter TargetName="ActionGlyph" Property="Visibility" Value="Visible" /><Setter TargetName="ActionGlyph" Property="Data" Value="M12,4 A6,6 0 1 0 13,9 M9,4 H13 V0" /></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.07" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.14" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource CompactButton}">
        <Setter Property="Background" Value="{DynamicResource UI.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource UI.OnAccent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Dark">
                <Setter Property="Background" Value="{DynamicResource UI.Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource UI.OnAccent}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource CompactButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource UI.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UI.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="Medium" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Dark">
                <Setter Property="Foreground" Value="{DynamicResource UI.Text}" />
                <Setter Property="BorderBrush" Value="{DynamicResource UI.Border}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource CompactButton}">
        <Setter Property="Background" Value="{DynamicResource UI.Inset}" />
        <Setter Property="Foreground" Value="{DynamicResource UI.Muted}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="Medium" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Dark">
                <Setter Property="Foreground" Value="{DynamicResource UI.Muted}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NavActionButton" TargetType="Button" BasedOn="{StaticResource CompactButton}">
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="{DynamicResource UI.SidebarHover}" />
        <Setter Property="Foreground" Value="{DynamicResource UI.SidebarText}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Campos -->
    <Style x:Key="Input" TargetType="Control">
        <Setter Property="Height" Value="40" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource UI.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource UI.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UI.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Dark">
                <Setter Property="Background" Value="{DynamicResource UI.Surface}" />
                <Setter Property="Foreground" Value="{DynamicResource UI.Text}" />
                <Setter Property="BorderBrush" Value="{DynamicResource UI.Border}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FilterTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource UI.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UI.Border}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Dark">
                <Setter Property="Foreground" Value="{DynamicResource UI.Text}" />
                <Setter Property="BorderBrush" Value="{DynamicResource UI.Border}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- DataGrid -->
    <Style x:Key="ColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource UI.Inset}" />
        <Setter Property="Foreground" Value="{DynamicResource UI.Muted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Height" Value="38" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource UI.Border}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DataCell" TargetType="DataGridCell">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="12,0" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource UI.Selection}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DataRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource UI.Hover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HotelDataGrid" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="RowHeight" Value="46" />
        <Setter Property="ColumnHeaderHeight" Value="34" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{DynamicResource UI.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource UI.Text}" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource UI.RowAlternate}" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource ColumnHeader}" />
        <Setter Property="CellStyle" Value="{StaticResource DataCell}" />
        <Setter Property="RowStyle" Value="{StaticResource DataRow}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Dark">
                <Setter Property="Foreground" Value="{DynamicResource UI.Text}" />
                <Setter Property="AlternatingRowBackground" Value="{DynamicResource UI.RowAlternate}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Gráficos de barras -->
    <Style x:Key="BarTrack" TargetType="Border">
        <Setter Property="Height" Value="7" />
        <Setter Property="CornerRadius" Value="3.5" />
        <Setter Property="Background" Value="{DynamicResource UI.Hover}" />
    </Style>

    <Style x:Key="BarFill" TargetType="Border">
        <Setter Property="Height" Value="7" />
        <Setter Property="CornerRadius" Value="3.5" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{DynamicResource UI.Accent}" />
    </Style>

    <!-- Panel emergente -->
    <Style x:Key="OverlayCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource UI.Surface}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="26,22" />
        <Setter Property="MaxWidth" Value="600" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.35" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Dark">
                <Setter Property="Background" Value="{DynamicResource UI.Surface}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="EstadoPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Background" Value="{DynamicResource UI.Hover}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- Contenedor de sección: encabezado + contenido declarado en la vista. -->
    <Style x:Key="SectionCardStyle" TargetType="{x:Type controls:SectionCard}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SectionCard}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{TemplateBinding Titulo}" Style="{StaticResource CardTitle}" />
                                <TextBlock Grid.Column="1" Text="{TemplateBinding Nota}"
                                           Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center" FontSize="11" />
                            </Grid>
                            <ContentPresenter Margin="0,12,0,0" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AvailabilityBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource UI.WarningSurface}" />
        <Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="8,5" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Style.Triggers><DataTrigger Binding="{Binding EstaDisponible}" Value="True"><Setter Property="Background" Value="{DynamicResource UI.SuccessSurface}" /></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="AvailabilityText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource UI.Warning}" /><Setter Property="FontSize" Value="11.5" />
        <Style.Triggers><DataTrigger Binding="{Binding EstaDisponible}" Value="True"><Setter Property="Foreground" Value="{DynamicResource UI.Success}" /></DataTrigger></Style.Triggers>
    </Style>
    <Style TargetType="DataGrid" BasedOn="{StaticResource HotelDataGrid}" />
</ResourceDictionary>
