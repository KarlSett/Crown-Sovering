<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                    xmlns:theme="clr-namespace:Crown__.Frontend.Themes">
    <!-- Native WPF controls keep keyboard, focus, selection and automation behavior. -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource UI.Page}" />
        <Setter Property="Foreground" Value="{DynamicResource UI.Text}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style TargetType="UserControl">
        <Setter Property="Foreground" Value="{DynamicResource UI.Text}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style x:Key="ModernButton" TargetType="Button">
        <Setter Property="theme:ThemePresentation.SmoothHover" Value="True" />
        <Setter Property="Background" Value="{DynamicResource UI.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource UI.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UI.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Button">
                <Grid>
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                            <Path x:Name="ActionGlyph" Data="M1,7 H13 M7,1 V13" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" Width="14" Height="14" Margin="0,0,8,0" Visibility="Collapsed" Stretch="Uniform" />
                            <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="Hover" Background="{TemplateBinding Foreground}" Opacity="0" CornerRadius="7" IsHitTestVisible="False" />
                    <Border x:Name="Focus" BorderBrush="{DynamicResource UI.Focus}" BorderThickness="2" CornerRadius="9" Margin="-2" Visibility="Collapsed" IsHitTestVisible="False" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="Content" Value="Nueva reserva"><Setter TargetName="ActionGlyph" Property="Visibility" Value="Visible" /></Trigger>
                    <Trigger Property="Content" Value="Nueva habitación"><Setter TargetName="ActionGlyph" Property="Visibility" Value="Visible" /></Trigger>
                    <Trigger Property="Content" Value="Nuevo huésped"><Setter TargetName="ActionGlyph" Property="Visibility" Value="Visible" /></Trigger>
                    <Trigger Property="Content" Value="Guardar"><Setter TargetName="ActionGlyph" Property="Visibility" Value="Visible" /><Setter TargetName="ActionGlyph" Property="Data" Value="M1,7 L5,11 13,2" /></Trigger>
                    <Trigger Property="Content" Value="Guardar reserva"><Setter TargetName="ActionGlyph" Property="Visibility" Value="Visible" /><Setter TargetName="ActionGlyph" Property="Data" Value="M1,7 L5,11 13,2" /></Trigger>
                    <Trigger Property="Content" Value="Buscar"><Setter TargetName="ActionGlyph" Property="Visibility" Value="Visible" /><Setter TargetName="ActionGlyph" Property="Data" Value="M10,5 A4,4 0 1 1 2,5 A4,4 0 1 1 10,5 M9,9 L14,14" /></Trigger>
                    <Trigger Property="Content" Value="Buscar disponibilidad"><Setter TargetName="ActionGlyph" Property="Visibility" Value="Visible" /><Setter TargetName="ActionGlyph" Property="Data" Value="M10,5 A4,4 0 1 1 2,5 A4,4 0 1 1 10,5 M9,9 L14,14" /></Trigger>
                    <Trigger Property="Content" Value="Actualizar"><Setter TargetName="ActionGlyph" Property="Visibility" Value="Visible" /><Setter TargetName="ActionGlyph" Property="Data" Value="M12,4 A6,6 0 1 0 13,9 M9,4 H13 V0" /></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.07" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.14" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
        <Style.Triggers>
            <Trigger Property="IsDefault" Value="True"><Setter Property="Background" Value="{DynamicResource UI.Accent}" /><Setter Property="Foreground" Value="{DynamicResource UI.OnAccent}" /></Trigger>
            <Trigger Property="Content" Value="Guardar"><Setter Property="Background" Value="{DynamicResource UI.Accent}" /><Setter Property="Foreground" Value="{DynamicResource UI.OnAccent}" /></Trigger>
            <Trigger Property="Content" Value="Nueva reserva"><Setter Property="Background" Value="{DynamicResource UI.Accent}" /><Setter Property="Foreground" Value="{DynamicResource UI.OnAccent}" /></Trigger>
            <Trigger Property="Content" Value="Nueva habitación"><Setter Property="Background" Value="{DynamicResource UI.Accent}" /><Setter Property="Foreground" Value="{DynamicResource UI.OnAccent}" /></Trigger>
            <Trigger Property="Content" Value="Nuevo huésped"><Setter Property="Background" Value="{DynamicResource UI.Accent}" /><Setter Property="Foreground" Value="{DynamicResource UI.OnAccent}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ModernTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource UI.Inset}" />
        <Setter Property="Foreground" Value="{DynamicResource UI.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource UI.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource UI.Selection}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UI.Border}" />
        <Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="34" /><Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="TextBox">
                <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource UI.Focus}" /></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource UI.Focus}" /><Setter TargetName="Field" Property="BorderThickness" Value="2" /></Trigger>
                    <Trigger Property="IsReadOnly" Value="True"><Setter Property="Background" Value="{DynamicResource UI.Hover}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                    <Trigger Property="Validation.HasError" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource UI.Danger}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}" />
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource UI.Text}" />
        <Setter Property="Padding" Value="10,9" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="Surface" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource UI.Hover}" /></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource UI.Selection}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource UI.Inset}" />
        <Setter Property="Foreground" Value="{DynamicResource UI.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UI.Border}" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ComboBox">
                <Grid>
                    <ToggleButton x:Name="DropButton" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="8">
                                <Path Data="M0,0 L4,4 8,0" Stroke="{DynamicResource UI.Muted}" StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                            </Border>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                      Margin="11,3,32,3" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <Border x:Name="Focus" BorderBrush="{DynamicResource UI.Focus}" BorderThickness="2" CornerRadius="8" IsHitTestVisible="False" Visibility="Collapsed" />
                    <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
                        <Border Background="{DynamicResource UI.Surface}" BorderBrush="{DynamicResource UI.Border}" BorderThickness="1" CornerRadius="10" Margin="0,4,0,0" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                            <ScrollViewer MaxHeight="300" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource UI.Focus}" /></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible" /></Trigger>
                    <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="CalendarStyle" Value="{DynamicResource {x:Type Calendar}}" />
        <Setter Property="Background" Value="{DynamicResource UI.Inset}" />
        <Setter Property="Foreground" Value="{DynamicResource UI.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UI.Border}" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="SelectedDateFormat" Value="Short" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="DatePicker">
                <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="5,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                        <primitives:DatePickerTextBox x:Name="PART_TextBox" Background="Transparent" Foreground="{TemplateBinding Foreground}" BorderThickness="0" VerticalContentAlignment="Center" Padding="4,0" />
                        <Button x:Name="PART_Button" Grid.Column="1" Focusable="False" Background="Transparent" BorderThickness="0" Margin="0" Padding="5" MinHeight="0" AutomationProperties.Name="Abrir calendario">
                            <Path Data="M1,3 H13 V14 H1 Z M1,6 H13 M4,1 V4 M10,1 V4" Stroke="{DynamicResource UI.Muted}" StrokeThickness="1.2" Width="14" Height="15" />
                        </Button>
                        <Popup x:Name="PART_Popup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" />
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource UI.Focus}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style TargetType="primitives:DatePickerTextBox" BasedOn="{StaticResource ModernTextBox}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="primitives:DatePickerTextBox">
                <Grid>
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    <ContentControl x:Name="PART_Watermark" Visibility="Collapsed" Foreground="{DynamicResource UI.Muted}" Margin="4,0" VerticalAlignment="Center" IsHitTestVisible="False" Focusable="False" />
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="Text" Value=""><Setter TargetName="PART_Watermark" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style TargetType="Calendar">
        <Setter Property="Background" Value="{DynamicResource UI.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource UI.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UI.Border}" />
        <Setter Property="CalendarItemStyle" Value="{DynamicResource {x:Type primitives:CalendarItem}}" />
        <Setter Property="CalendarDayButtonStyle" Value="{DynamicResource {x:Type primitives:CalendarDayButton}}" />
        <Setter Property="CalendarButtonStyle" Value="{DynamicResource {x:Type primitives:CalendarButton}}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Calendar">
            <Grid x:Name="PART_Root"><primitives:CalendarItem x:Name="PART_CalendarItem" Style="{TemplateBinding CalendarItemStyle}" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" /></Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="primitives:CalendarItem">
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="primitives:CalendarItem">
                <ControlTemplate.Resources><DataTemplate x:Key="{x:Static primitives:CalendarItem.DayTitleTemplateResourceKey}"><TextBlock Text="{Binding}" Foreground="{DynamicResource UI.Muted}" HorizontalAlignment="Center" FontSize="11" Margin="0,4" /></DataTemplate></ControlTemplate.Resources>
                <Border Background="{DynamicResource UI.Surface}" BorderBrush="{DynamicResource UI.Border}" BorderThickness="1" CornerRadius="10" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                            <Button x:Name="PART_PreviousButton" Padding="0" Margin="0" AutomationProperties.Name="Mes anterior"><Path Data="M5,0 L0,5 5,10" Stroke="{DynamicResource UI.Text}" StrokeThickness="1.4" /></Button>
                            <Button x:Name="PART_HeaderButton" Grid.Column="1" Padding="6" Margin="2,0" />
                            <Button x:Name="PART_NextButton" Grid.Column="2" Padding="0" Margin="0" AutomationProperties.Name="Mes siguiente"><Path Data="M0,0 L5,5 0,10" Stroke="{DynamicResource UI.Text}" StrokeThickness="1.4" /></Button>
                        </Grid>
                        <Grid x:Name="PART_MonthView" Grid.Row="1" Margin="0,8,0,0">
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        </Grid>
                        <Grid x:Name="PART_YearView" Grid.Row="1" Visibility="Hidden">
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        </Grid>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Year"><Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" /><Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" /></DataTrigger>
                    <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Decade"><Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" /><Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" /></DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style TargetType="primitives:CalendarDayButton" BasedOn="{StaticResource ModernButton}">
        <Setter Property="MinWidth" Value="30" /><Setter Property="MinHeight" Value="30" /><Setter Property="Margin" Value="1" /><Setter Property="Padding" Value="3" /><Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsToday" Value="True"><Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="{DynamicResource UI.Focus}" /></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource UI.Accent}" /><Setter Property="Foreground" Value="{DynamicResource UI.OnAccent}" /></Trigger>
            <Trigger Property="IsInactive" Value="True"><Setter Property="Opacity" Value="0.45" /></Trigger>
            <Trigger Property="IsBlackedOut" Value="True"><Setter Property="Opacity" Value="0.3" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="primitives:CalendarButton" BasedOn="{StaticResource ModernButton}">
        <Setter Property="Margin" Value="2" /><Setter Property="Padding" Value="5" />
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" /><Setter Property="Background" Value="Transparent" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
                <Grid Background="Transparent">
                    <primitives:Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                        <primitives:Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></primitives:Track.DecreaseRepeatButton>
                        <primitives:Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" Background="{DynamicResource UI.Muted}" Opacity="0.35" CornerRadius="4" Margin="2"></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Opacity" Value="0.7" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></primitives:Track.Thumb>
                        <primitives:Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></primitives:Track.IncreaseRepeatButton>
                    </primitives:Track>
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto" /><Setter Property="Height" Value="10" /><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource UI.Text}" />
        <Setter Property="Margin" Value="0,10,8,0" /><Setter Property="Padding" Value="12" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="GroupBox">
                <Border Background="{DynamicResource UI.Surface}" BorderBrush="{DynamicResource UI.Border}" BorderThickness="1" CornerRadius="10">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Background="{DynamicResource UI.Inset}" BorderBrush="{DynamicResource UI.Border}" BorderThickness="0,0,0,1" CornerRadius="9,9,0,0" Padding="12,10">
                            <ContentPresenter ContentSource="Header" TextElement.FontWeight="SemiBold" TextElement.FontSize="12.5" />
                        </Border>
                        <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource UI.Text}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,9" /><Setter Property="Margin" Value="0,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource UI.Text}" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Surface" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter /></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource UI.Hover}" /></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource UI.Selection}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource UI.Focus}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource UI.Surface}" /><Setter Property="Foreground" Value="{DynamicResource UI.Text}" />
        <Setter Property="Padding" Value="12" /><Setter Property="Margin" Value="0,10,8,0" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="TabControl">
                <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource UI.Border}" BorderThickness="1" CornerRadius="10">
                    <DockPanel>
                        <Border x:Name="TabRail" DockPanel.Dock="Top" Background="{DynamicResource UI.Inset}" CornerRadius="7" Padding="4" Margin="8,8,8,0">
                            <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="{TemplateBinding Padding}" KeyboardNavigation.TabIndex="2" />
                    </DockPanel>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="TabStripPlacement" Value="Left"><Setter TargetName="TabRail" Property="DockPanel.Dock" Value="Left" /><Setter TargetName="TabRail" Property="Margin" Value="8" /></Trigger>
                    <Trigger Property="TabStripPlacement" Value="Right"><Setter TargetName="TabRail" Property="DockPanel.Dock" Value="Right" /></Trigger>
                    <Trigger Property="TabStripPlacement" Value="Bottom"><Setter TargetName="TabRail" Property="DockPanel.Dock" Value="Bottom" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource UI.Muted}" /><Setter Property="Padding" Value="12,8" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="TabItem">
                <Border x:Name="Surface" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource UI.Hover}" /></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource UI.Accent}" /><Setter Property="Foreground" Value="{DynamicResource UI.OnAccent}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource UI.Focus}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="RoomTile" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource UI.Text}" /><Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="RadioButton">
                <Border x:Name="Surface" Background="{DynamicResource UI.Inset}" BorderBrush="{DynamicResource UI.Border}" BorderThickness="1" CornerRadius="6" Padding="10,7">
                    <Grid>
                        <Path x:Name="RoomGlyph" Data="M5,1 H18 V19 H5 Z M14,9 V11 M2,19 H22" Stroke="{DynamicResource UI.Muted}" StrokeThickness="1.2" Width="22" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.6" />
                        <Ellipse x:Name="StatusDot" Fill="{DynamicResource UI.Warning}" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        <StackPanel><TextBlock Text="{TemplateBinding Content}" FontSize="16" FontWeight="SemiBold" /><TextBlock x:Name="RoomType" Text="{Binding Tipo}" FontSize="11" Foreground="{DynamicResource UI.Muted}" Margin="0,3,0,0" /></StackPanel>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource UI.Hover}" /><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource UI.Focus}" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource UI.Accent}" /><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource UI.Focus}" /><Setter TargetName="RoomGlyph" Property="Data" Value="M4,9 L9,14 19,4" /><Setter Property="Foreground" Value="{DynamicResource UI.OnAccent}" /><Setter TargetName="RoomType" Property="Foreground" Value="{DynamicResource UI.OnAccent}" /><Setter TargetName="RoomGlyph" Property="Stroke" Value="{DynamicResource UI.OnAccent}" /></Trigger>
                    <DataTrigger Binding="{Binding EstaDisponible}" Value="True"><Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource UI.Success}" /></DataTrigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderThickness" Value="2" /><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource UI.Focus}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
</ResourceDictionary>
