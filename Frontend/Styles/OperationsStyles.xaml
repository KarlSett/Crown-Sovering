<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="InlineTabs" TargetType="TabControl">
        <Setter Property="Margin" Value="0" /><Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}"><Setter Property="Padding" Value="9,6" /></Style></Setter.Value></Setter>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
            <DockPanel>
                <TabPanel DockPanel.Dock="Top" IsItemsHost="True" Margin="0,0,0,8" />
                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
            </DockPanel>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="StaySummaryTemplate">
        <StackPanel>
            <TextBlock Text="{Binding Codigo}" Foreground="{DynamicResource UI.Muted}" FontSize="10" />
            <TextBlock Text="{Binding Huesped}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,5,0,5" />
            <TextBlock Foreground="{DynamicResource UI.Muted}" FontSize="10.5"><Run Text="Habitación " /><Run Text="{Binding Habitacion}" /><Run Text=" · " /><Run Text="{Binding Noches}" /><Run Text=" noches" /></TextBlock>
            <Border Background="{DynamicResource UI.Selection}" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" Margin="0,7,0,2"><TextBlock Text="{Binding Estado}" FontSize="10" Foreground="{DynamicResource UI.Text}" /></Border>
        </StackPanel>
    </DataTemplate>
    <Style x:Key="CalendarDaySurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource UI.Inset}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderBrush" Value="{DynamicResource UI.Border}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Style.Triggers><DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="Background" Value="{DynamicResource UI.BoardToday}" /></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="BookingTile" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" /><Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        <Setter Property="ToolTip" Value="{Binding AccessibleName}" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="RadioButton">
                <Border x:Name="Surface" Background="{DynamicResource UI.Surface}" BorderBrush="{DynamicResource UI.Border}" BorderThickness="1" CornerRadius="7" Padding="10">
                    <StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ShortCode}" Foreground="{DynamicResource UI.Muted}" FontSize="10" FontWeight="SemiBold" />
                            <Path Grid.Column="1" Data="M1,0 H9 V11 H1 Z M7,5 V7" Stroke="{DynamicResource UI.Muted}" StrokeThickness="1" Width="10" Height="12" />
                        </Grid>
                        <TextBlock Text="{Binding ShortName}" Foreground="{DynamicResource UI.Text}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,8,0,4" />
                        <TextBlock Text="{Binding RoomSummary}" Foreground="{DynamicResource UI.Muted}" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                        <Border x:Name="StatusSurface" Background="{DynamicResource UI.SuccessSurface}" CornerRadius="4" HorizontalAlignment="Left" Padding="5,3" Margin="0,9,0,0">
                            <TextBlock x:Name="StatusText" Text="{Binding Reservation.Estado}" Foreground="{DynamicResource UI.Success}" FontSize="9.5" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding Reservation.EstadoCrudo}" Value="EnCurso"><Setter TargetName="StatusSurface" Property="Background" Value="{DynamicResource UI.Selection}" /><Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource UI.Text}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Reservation.EstadoCrudo}" Value="Cancelada"><Setter TargetName="StatusSurface" Property="Background" Value="{DynamicResource UI.DangerSurface}" /><Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource UI.Danger}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Reservation.EstadoCrudo}" Value="NoShow"><Setter TargetName="StatusSurface" Property="Background" Value="{DynamicResource UI.WarningSurface}" /><Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource UI.Warning}" /></DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource UI.Focus}" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource UI.Selection}" /><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource UI.Focus}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource UI.Focus}" /><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="ReservationDayTemplate">
        <Border Style="{StaticResource CalendarDaySurface}">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Margin="10,12,10,10">
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource UI.Muted}" FontSize="11" FontWeight="SemiBold" />
                    <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DayNumber}" Foreground="{DynamicResource UI.Text}" FontSize="23" FontWeight="SemiBold" />
                        <Border Grid.Column="1" Background="{DynamicResource UI.Accent}" CornerRadius="4" Padding="5,3" VerticalAlignment="Center">
                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                            <TextBlock Text="Hoy" Foreground="{DynamicResource UI.OnAccent}" FontSize="9" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding CountLabel}" Foreground="{DynamicResource UI.Muted}" FontSize="10" Margin="0,5,0,0" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6,0,6,6">
                    <ItemsControl ItemsSource="{Binding Bookings}"><ItemsControl.ItemTemplate><DataTemplate>
                        <RadioButton GroupName="CalendarReservations" IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{StaticResource BookingTile}" />
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
