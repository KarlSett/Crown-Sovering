<UserControl x:Class="Crown__.Frontend.Views.Modules.LimpiezaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Limpieza y mantenimiento" VerticalAlignment="Center" />
            <Button Content="Nueva tarea" Click="OnNuevaTarea" />
            <Button Content="Registrar incidencia" Click="OnIncidencia" />
            <Button Content="Nueva orden" Click="OnNuevaOrden" />
            <Button Content="Avanzar seleccionada" Click="OnAvanzar" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Pendientes">
                <ListBox x:Name="LstPendientes" DisplayMemberPath="Etiqueta" SelectionChanged="OnSeleccionTarea" />
            </GroupBox>
            <GroupBox Grid.Column="1" Header="En curso">
                <ListBox x:Name="LstEnCurso" DisplayMemberPath="Etiqueta" SelectionChanged="OnSeleccionTarea" />
            </GroupBox>
            <GroupBox Grid.Column="2" Header="Completadas">
                <ListBox x:Name="LstCompletadas" DisplayMemberPath="Etiqueta" SelectionChanged="OnSeleccionTarea" />
            </GroupBox>
        </Grid>

        <TabControl Grid.Row="2">
            <TabItem Header="Checklists">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <TextBlock Text="Nombre" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtChecklist" Width="170" />
                        <TextBlock Text="Descripción" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtDescripcionChecklist" Width="230" />
                        <Button Content="Guardar" Click="OnGuardarChecklist" />
                    </WrapPanel>
                    <DataGrid x:Name="GridChecklists" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Checklist" Binding="{Binding Nombre}" />
                            <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Ítems de checklist">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <TextBlock Text="Checklist" VerticalAlignment="Center" />
                        <ComboBox x:Name="CmbChecklist" Width="180" DisplayMemberPath="Nombre" />
                        <TextBlock Text="Descripción" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtItemChecklist" Width="280" />
                        <Button Content="Guardar" Click="OnGuardarItemChecklist" />
                    </WrapPanel>
                    <DataGrid x:Name="GridItemsChecklist" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Checklist" Binding="{Binding Checklist}" />
                            <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" />
                            <DataGridCheckBoxColumn Header="Completado" Binding="{Binding Completado, UpdateSourceTrigger=PropertyChanged}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Inspecciones">
                <DataGrid AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tarea" />
                        <DataGridTextColumn Header="Empleado" />
                        <DataGridTextColumn Header="Resultado" />
                        <DataGridTextColumn Header="Fecha" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Incidencias">
                <DataGrid AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Habitación" />
                        <DataGridTextColumn Header="Tipo" />
                        <DataGridTextColumn Header="Descripción" />
                        <DataGridTextColumn Header="Estado" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Órdenes de mantenimiento">
                <DataGrid AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Orden" />
                        <DataGridTextColumn Header="Incidencia" />
                        <DataGridTextColumn Header="Empleado" />
                        <DataGridTextColumn Header="Estado" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Objetos olvidados">
                <DataGrid AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Habitación" />
                        <DataGridTextColumn Header="Descripción" />
                        <DataGridTextColumn Header="Encontrado" />
                        <DataGridTextColumn Header="Estado" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
