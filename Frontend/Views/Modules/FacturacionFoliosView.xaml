<UserControl x:Class="Crown__.Frontend.Views.Modules.FacturacionFoliosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Facturación" VerticalAlignment="Center" />
            <TextBlock Text="Buscar…" VerticalAlignment="Center" />
            <TextBox x:Name="TxtBuscar" Width="180" TextChanged="OnBuscar" />
            <Button Content="Buscar" Click="OnBuscar" />
            <Button Content="Nuevo folio" Click="OnNuevoFolio" />
            <Button Content="Transferir cargo" Click="OnTransferirCargo" />
            <Button Content="Emitir factura" Click="OnEmitirFactura" />
            <Button Content="Nota de crédito" Click="OnCrearNota" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Folios abiertos">
                <ListBox x:Name="LstFolios" DisplayMemberPath="Texto" SelectionChanged="OnSeleccionFolio" />
            </GroupBox>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox Header="Resumen del folio">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Huésped" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtHuesped" Grid.Column="1" IsReadOnly="True" />
                        <TextBlock Grid.Column="2" Text="Estado" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtEstadoFolio" Grid.Column="3" IsReadOnly="True" />
                        <TextBlock Grid.Column="4" Text="Saldo" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtSaldo" Grid.Column="5" IsReadOnly="True" />
                    </Grid>
                </GroupBox>

                <TabControl Grid.Row="1">
                    <TabItem Header="Cargos">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Concepto" VerticalAlignment="Center" />
                                <ComboBox x:Name="CmbConcepto" Width="140" />
                                <TextBlock Text="Descripción" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtDescripcionCargo" Width="200" />
                                <TextBlock Text="Cantidad" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtCantidad" Width="70" Text="1" />
                                <TextBlock Text="Precio" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtPrecio" Width="90" />
                                <Button Content="Agregar" Click="OnAgregarCargo" />
                            </StackPanel>
                            <DataGrid x:Name="GridCargos" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat={}{0:g}}" />
                                    <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" />
                                    <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" />
                                    <DataGridTextColumn Header="Precio" Binding="{Binding Cargo}" />
                                    <DataGridTextColumn Header="Importe" Binding="{Binding Cargo}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Conceptos">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Nombre" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtNuevoConcepto" Width="180" />
                                <TextBlock Text="Categoría" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtCategoriaConcepto" Width="150" />
                                <Button Content="Guardar" Click="OnGuardarConcepto" />
                            </StackPanel>
                            <DataGrid x:Name="GridConceptos" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Concepto" Binding="{Binding Nombre}" />
                                    <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Facturas">
                        <DataGrid x:Name="GridFacturas" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Número" Binding="{Binding Numero}" />
                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat={}{0:d}}" />
                                <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal}" />
                                <DataGridTextColumn Header="Impuesto" Binding="{Binding Impuesto}" />
                                <DataGridTextColumn Header="Total" Binding="{Binding Total}" />
                                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="Notas de crédito">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Factura" VerticalAlignment="Center" />
                                <ComboBox x:Name="CmbFactura" Width="140" DisplayMemberPath="Numero" />
                                <TextBlock Text="Motivo" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtMotivoNC" Width="220" />
                                <TextBlock Text="Monto" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtMontoNC" Width="90" />
                                <Button Content="Crear" Click="OnGuardarNota" />
                            </StackPanel>
                            <DataGrid x:Name="GridNotas" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Número" Binding="{Binding Numero}" />
                                    <DataGridTextColumn Header="Factura" Binding="{Binding Factura}" />
                                    <DataGridTextColumn Header="Motivo" Binding="{Binding Motivo}" />
                                    <DataGridTextColumn Header="Monto" Binding="{Binding Monto}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
