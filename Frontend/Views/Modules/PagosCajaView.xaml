<UserControl x:Class="Crown__.Frontend.Views.Modules.PagosCajaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="200" />
        </Grid.RowDefinitions>

        <GroupBox Header="Turno de caja">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Usuario" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Column="1" IsReadOnly="True" Margin="0,2,6,2" />
                <TextBlock Grid.Column="2" Text="Apertura" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Column="3" IsReadOnly="True" Margin="0,2,6,2" />
                <TextBlock Grid.Column="4" Text="Estado" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Column="5" IsReadOnly="True" Margin="0,2,6,2" />
                <StackPanel Grid.Column="6" Orientation="Horizontal">
                    <Button Content="Abrir turno" />
                    <Button Content="Cerrar turno" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Pagos del turno">
                <ListBox>
                    <ListBoxItem Content="Pago · Folio · Monto" />
                    <ListBoxItem Content="Pago · Folio · Monto" />
                    <ListBoxItem Content="Pago · Folio · Monto" />
                    <ListBoxItem Content="Pago · Folio · Monto" />
                </ListBox>
            </GroupBox>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <GroupBox Header="Movimientos de caja">
                    <DataGrid AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tipo" />
                            <DataGridTextColumn Header="Monto" />
                            <DataGridTextColumn Header="Fecha" />
                            <DataGridTextColumn Header="Pago" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
                <GroupBox Grid.Row="1" Header="Cierre de caja">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Esperado" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Column="1" IsReadOnly="True" Margin="0,2,6,2" />
                        <TextBlock Grid.Column="2" Text="Contado" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Column="3" Margin="0,2,6,2" />
                        <TextBlock Grid.Column="4" Text="Diferencia" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Column="5" IsReadOnly="True" Margin="0,2,6,2" />
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>

        <TabControl Grid.Row="2">
            <TabItem Header="Métodos de pago">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal">
                        <TextBlock Text="Nombre" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="180" Margin="0,2,6,2" />
                        <CheckBox Content="Activo" VerticalAlignment="Center" />
                        <Button Content="Guardar" />
                    </StackPanel></ScrollViewer>
                    <DataGrid Grid.Row="1" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Método" />
                            <DataGridTextColumn Header="Activo" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Devoluciones y anulaciones">
                <DataGrid AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pago" />
                        <DataGridTextColumn Header="Tipo" />
                        <DataGridTextColumn Header="Monto" />
                        <DataGridTextColumn Header="Motivo" />
                        <DataGridTextColumn Header="Estado" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Nuevo movimiento">
                <WrapPanel>
                    <TextBlock Text="Tipo" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="120" Margin="0,2,6,2" />
                    <TextBlock Text="Monto" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Width="90" Margin="0,2,6,2" />
                    <TextBlock Text="Motivo" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Width="200" Margin="0,2,6,2" />
                    <Button Content="Registrar" />
                </WrapPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
