<UserControl x:Class="Crown__.Frontend.Views.Modules.PagosCajaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="200" />
        </Grid.RowDefinitions>

        <GroupBox Header="Turno de caja">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Usuario" VerticalAlignment="Center" />
                <TextBox x:Name="TxtUsuario" Grid.Column="1" IsReadOnly="True" />
                <TextBlock Grid.Column="2" Text="Apertura" VerticalAlignment="Center" />
                <TextBox x:Name="TxtApertura" Grid.Column="3" IsReadOnly="True" />
                <TextBlock Grid.Column="4" Text="Estado" VerticalAlignment="Center" />
                <TextBox x:Name="TxtEstadoTurno" Grid.Column="5" IsReadOnly="True" />
                <StackPanel Grid.Column="6" Orientation="Horizontal">
                    <Button Content="Abrir turno" Click="OnAbrirTurno" />
                    <Button Content="Cerrar turno" Click="OnCerrarTurno" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Pagos del turno">
                <ListBox x:Name="LstPagos" DisplayMemberPath="Concepto" />
            </GroupBox>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <GroupBox Header="Movimientos de caja">
                    <DataGrid x:Name="GridMovimientos" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Concepto}" />
                            <DataGridTextColumn Header="Monto" Binding="{Binding Abono}" />
                            <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat={}{0:g}}" />
                            <DataGridTextColumn Header="Pago" Binding="{Binding MetodoPago}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
                <GroupBox Grid.Row="1" Header="Cierre de caja">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Esperado" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtEsperado" Grid.Column="1" IsReadOnly="True" />
                        <TextBlock Grid.Column="2" Text="Contado" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtContado" Grid.Column="3" TextChanged="OnContadoChanged" />
                        <TextBlock Grid.Column="4" Text="Diferencia" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtDiferencia" Grid.Column="5" IsReadOnly="True" />
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>

        <TabControl Grid.Row="2">
            <TabItem Header="Métodos de pago">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Nombre" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtMetodoNuevo" Width="180" />
                        <CheckBox Content="Activo" VerticalAlignment="Center" />
                    <Button Content="Guardar" Click="OnGuardarMetodo" />
                    </StackPanel>
                    <DataGrid x:Name="GridMetodos" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Método" Binding="{Binding}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Devoluciones y anulaciones">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Button Content="Nueva devolución del pago seleccionado" Click="OnNuevaDevolucion" HorizontalAlignment="Left"/><DataGrid x:Name="GridDevoluciones" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Pago" Binding="{Binding TransaccionId}"/><DataGridTextColumn Header="Monto" Binding="{Binding Monto}"/><DataGridTextColumn Header="Motivo" Binding="{Binding Motivo}"/><DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat={}{0:g}}"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}"/></DataGrid.Columns></DataGrid></Grid>
            </TabItem>

            <TabItem Header="Nuevo movimiento">
                <WrapPanel>
                    <TextBlock Text="Folio" VerticalAlignment="Center"/><ComboBox x:Name="CmbFolio" Width="160" DisplayMemberPath="Texto"/>
                    <TextBlock Text="Tipo" VerticalAlignment="Center" />
                    <ComboBox x:Name="CmbMetodo" Width="120" />
                    <TextBlock Text="Monto" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtMonto" Width="90" />
                    <TextBlock Text="Motivo" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtMotivo" Width="200" />
                    <Button Content="Registrar pago" Click="OnRegistrarPago" />
                </WrapPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
