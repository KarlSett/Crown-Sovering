<UserControl x:Class="Crown__.Frontend.Views.Modules.NotificacionesReportesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="OnLoaded">
    <TabControl x:Name="TabsNotificaciones">
        <TabItem Header="Bandeja de notificaciones">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <GroupBox Header="Notificaciones">
                    <ListBox x:Name="LstNotificaciones" DisplayMemberPath="Titulo" SelectionChanged="OnSeleccionNotificacion" />
                </GroupBox>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <GroupBox Header="Mensaje">
                        <StackPanel>
                            <TextBlock Text="Título" />
                            <TextBox x:Name="TxtTituloNotificacion" IsReadOnly="True" />
                            <TextBlock Text="Mensaje" />
                            <TextBox x:Name="TxtMensajeNotificacion" Height="80" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="1" Header="Destinatarios">
                        <DataGrid x:Name="GridDestinatarios" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Rol" Binding="{Binding Rol}" />
                                <DataGridTextColumn Header="Enviada" Binding="{Binding Fecha, StringFormat={}{0:g}}" />
                                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Grid.Row="2" Header="Nueva notificación">
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Text="Rol" VerticalAlignment="Center" />
                                <ComboBox x:Name="CmbRol" Width="160" />
                                <Button Content="Enviar" Click="OnEnviar" />
                            </WrapPanel>
                            <TextBox x:Name="TxtNuevaNotificacion" Height="50" AcceptsReturn="True" />
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </Grid>
        </TabItem>

        <TabItem Header="Reportes programados">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <WrapPanel>
                    <TextBlock Text="Nombre" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtNombreReporte" Width="160" />
                    <TextBlock Text="Tipo" VerticalAlignment="Center" />
                    <ComboBox x:Name="CmbTipoReporte" Width="120" />
                    <TextBlock Text="Formato" VerticalAlignment="Center" />
                    <ComboBox x:Name="CmbFormato" Width="100" />
                    <TextBlock Text="Frecuencia" VerticalAlignment="Center" />
                    <ComboBox x:Name="CmbFrecuencia" Width="120" />
                    <TextBlock Text="Correo" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtCorreoReporte" Width="160" />
                    <CheckBox x:Name="ChkReporteActivo" Content="Activo" VerticalAlignment="Center" IsChecked="True" />
                    <Button Content="Guardar" Click="OnGuardarReporte" />
                </WrapPanel>
                <DataGrid x:Name="GridReportes" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="OnSeleccionReporte">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Reporte" Binding="{Binding Nombre}" />
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" />
                        <DataGridTextColumn Header="Formato" Binding="{Binding Formato}" />
                        <DataGridTextColumn Header="Frecuencia" Binding="{Binding Frecuencia}" />
                        <DataGridTextColumn Header="Correo" Binding="{Binding Correo}" />
                        <DataGridTextColumn Header="Activo" Binding="{Binding Activo}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem Header="Ejecuciones">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <WrapPanel>
                    <TextBlock Text="Reporte" VerticalAlignment="Center" />
                    <ComboBox x:Name="CmbEjecutarReporte" Width="180" />
                    <TextBlock Text="Estado" VerticalAlignment="Center" />
                    <ComboBox Width="120" />
                    <TextBlock Text="Desde" VerticalAlignment="Center" />
                    <DatePicker />
                    <TextBlock Text="Hasta" VerticalAlignment="Center" />
                    <DatePicker />
                    <Button Content="Ejecutar seleccionado" Click="OnEjecutarReporte" />
                </WrapPanel>
                <DataGrid x:Name="GridEjecuciones" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Reporte" Binding="{Binding Reporte}" />
                        <DataGridTextColumn Header="Ejecutado" Binding="{Binding Fecha, StringFormat={}{0:g}}" />
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" />
                        <DataGridTextColumn Header="Archivo" Binding="{Binding Archivo}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
