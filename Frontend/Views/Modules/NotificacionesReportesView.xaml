<UserControl x:Class="Crown__.Frontend.Views.Modules.NotificacionesReportesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TabControl>
        <TabItem Header="Bandeja de notificaciones">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <GroupBox Header="Notificaciones">
                    <ListBox>
                        <ListBoxItem Content="Título · Fecha" />
                        <ListBoxItem Content="Título · Fecha" />
                        <ListBoxItem Content="Título · Fecha" />
                        <ListBoxItem Content="Título · Fecha" />
                    </ListBox>
                </GroupBox>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <GroupBox Header="Mensaje">
                        <StackPanel>
                            <TextBlock Text="Título" />
                            <TextBox IsReadOnly="True" Margin="0,2,6,2" />
                            <TextBlock Text="Mensaje" />
                            <TextBox Height="80" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,2,6,2" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="1" Header="Destinatarios">
                        <DataGrid AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Usuario" />
                                <DataGridTextColumn Header="Enviada" />
                                <DataGridTextColumn Header="Recibida" />
                                <DataGridTextColumn Header="Estado" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Grid.Row="2" Header="Nueva notificación">
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Text="Rol" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox Width="160" Margin="0,2,6,2" />
                                <Button Content="Enviar" />
                            </WrapPanel>
                            <TextBox Height="50" AcceptsReturn="True" Margin="0,2,6,2" />
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </Grid>
        </TabItem>

        <TabItem Header="Reportes programados">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <WrapPanel>
                    <TextBlock Text="Nombre" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Width="160" Margin="0,2,6,2" />
                    <TextBlock Text="Tipo" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="120" Margin="0,2,6,2" />
                    <TextBlock Text="Formato" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="100" Margin="0,2,6,2" />
                    <TextBlock Text="Frecuencia" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="120" Margin="0,2,6,2" />
                    <TextBlock Text="Correo" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Width="160" Margin="0,2,6,2" />
                    <CheckBox Content="Activo" VerticalAlignment="Center" />
                    <Button Content="Guardar" />
                </WrapPanel>
                <DataGrid Grid.Row="1" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Reporte" />
                        <DataGridTextColumn Header="Tipo" />
                        <DataGridTextColumn Header="Formato" />
                        <DataGridTextColumn Header="Frecuencia" />
                        <DataGridTextColumn Header="Correo" />
                        <DataGridTextColumn Header="Activo" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem Header="Ejecuciones">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <WrapPanel>
                    <TextBlock Text="Reporte" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="180" Margin="0,2,6,2" />
                    <TextBlock Text="Estado" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="120" Margin="0,2,6,2" />
                    <TextBlock Text="Desde" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <DatePicker />
                    <TextBlock Text="Hasta" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <DatePicker />
                    <Button Content="Buscar" />
                </WrapPanel>
                <DataGrid Grid.Row="1" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Reporte" />
                        <DataGridTextColumn Header="Ejecutado" />
                        <DataGridTextColumn Header="Estado" />
                        <DataGridTextColumn Header="Archivo" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
