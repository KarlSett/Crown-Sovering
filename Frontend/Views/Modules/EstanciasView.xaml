<UserControl x:Class="Crown__.Frontend.Views.Modules.EstanciasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal">
            <TextBlock Text="Estancias y llaves" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Text="Reserva o huésped" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="TxtBuscarEstancia" TextChanged="OnSearchChanged" Width="200" Margin="0,2,6,2" />
            <Button Content="Buscar" />
            <Button Content="Check-in" />
            <Button Content="Check-out" />
        </StackPanel></ScrollViewer>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Llegadas de hoy">
                <ListBox x:Name="ListaLlegadas" ItemTemplate="{StaticResource StaySummaryTemplate}" SelectionChanged="OnStaySelected" />
            </GroupBox>
            <GroupBox Grid.Column="1" Header="En casa">
                <ListBox x:Name="ListaEnCasa" ItemTemplate="{StaticResource StaySummaryTemplate}" SelectionChanged="OnStaySelected" />
            </GroupBox>
            <GroupBox Grid.Column="2" Header="Salidas de hoy">
                <ListBox x:Name="ListaSalidas" ItemTemplate="{StaticResource StaySummaryTemplate}" SelectionChanged="OnStaySelected" />
            </GroupBox>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Detalle de la estancia">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Reserva" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="TxtReservaEstancia" Grid.Column="1" IsReadOnly="True" Margin="0,2,6,2" />
                    <TextBlock Grid.Row="1" Text="Tipo de check-in" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="CmbEntradaEstancia" Grid.Row="1" Grid.Column="1" Margin="0,2,6,2" />
                    <TextBlock Grid.Row="2" Text="Tipo de check-out" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="CmbSalidaEstancia" Grid.Row="2" Grid.Column="1" Margin="0,2,6,2" />
                    <TextBlock Grid.Row="3" Text="Estado" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="CmbEstadoEstancia" Grid.Row="3" Grid.Column="1" Margin="0,2,6,2" />
                </Grid>
                </ScrollViewer>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Llaves de la estancia">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" />
                            <DataGridTextColumn Header="Emitida" />
                            <DataGridTextColumn Header="Devuelta" />
                            <DataGridTextColumn Header="Estado" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <Button Content="Emitir llave" />
                        <Button Content="Devolver llave" />
                        <Button Content="Mover de habitación" />
                        <Button Content="Imprimir estancia" />
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
