<UserControl x:Class="Crown__.Frontend.Views.Modules.EstanciasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Estancias y llaves" VerticalAlignment="Center" />
            <TextBlock Text="Reserva o huésped" VerticalAlignment="Center" />
            <TextBox x:Name="TxtBuscar" Width="200" TextChanged="OnBuscarCambia" />
            <Button Content="Buscar" Click="OnBuscar" />
            <Button x:Name="BtnCheckIn" Content="Check-in" Click="OnCheckIn" IsEnabled="False" />
            <Button x:Name="BtnCheckOut" Content="Check-out" Click="OnCheckOut" IsEnabled="False" />
        </StackPanel>

        <TextBlock x:Name="TxtAviso" Grid.Row="1" Margin="0,4,0,4" />

        <TabControl x:Name="TabsFlujo" Grid.Row="2" Margin="0,0,0,10">
            <TabItem Header="Llegadas · Check-in">
                <ListBox x:Name="ListaLlegadas" SelectionChanged="OnSeleccionLlegada" />
            </TabItem>
            <TabItem Header="Huéspedes alojados">
                <ListBox x:Name="ListaEnCasa" SelectionChanged="OnSeleccionEnCasa" />
            </TabItem>
            <TabItem Header="Salidas · Check-out">
                <ListBox x:Name="ListaSalidas" SelectionChanged="OnSeleccionSalida" />
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Detalle de la estancia">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Reserva" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtReserva" Grid.Column="1" IsReadOnly="True" />
                    <TextBlock Grid.Row="1" Text="Tipo de check-in" VerticalAlignment="Center" />
                    <ComboBox x:Name="CmbCheckin" Grid.Row="1" Grid.Column="1" />
                    <TextBlock Grid.Row="2" Text="Tipo de check-out" VerticalAlignment="Center" />
                    <ComboBox x:Name="CmbCheckout" Grid.Row="2" Grid.Column="1" />
                    <TextBlock Grid.Row="3" Text="Estado" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtEstado" Grid.Row="3" Grid.Column="1" IsReadOnly="True" />
                    <Button x:Name="BtnGuardarTipos" Grid.Row="4" Grid.Column="1" Content="Guardar tipos" Click="OnGuardarTipos" IsEnabled="False" HorizontalAlignment="Left" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Llaves de la estancia">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="GridLlaves" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="*" />
                            <DataGridTextColumn Header="Emitida" Binding="{Binding EmitidaTexto}" Width="*" />
                            <DataGridTextColumn Header="Devuelta" Binding="{Binding DevueltaTexto}" Width="*" />
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <TextBox x:Name="TxtCodigoLlave" Width="110" ToolTip="Código de la llave, por ejemplo T-101-A" />
                        <Button x:Name="BtnEmitirLlave" Content="Emitir llave" Click="OnEmitirLlave" IsEnabled="False" />
                        <Button x:Name="BtnDevolverLlave" Content="Devolver llave" Click="OnDevolverLlave" IsEnabled="False" />
                        <Button x:Name="BtnMover" Content="Mover de habitación" Click="OnMover" IsEnabled="False" />
                        <Button x:Name="BtnImprimir" Content="Imprimir estancia" Click="OnImprimir" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
