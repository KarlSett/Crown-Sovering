<UserControl x:Class="Crown__.Frontend.Views.Modules.EstanciasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Estancias y llaves" VerticalAlignment="Center" />
            <TextBlock Text="Reserva o huésped" VerticalAlignment="Center" />
            <TextBox x:Name="TxtBuscar" Width="200" TextChanged="OnBuscar" />
            <Button Content="Buscar" Click="OnBuscar" />
            <Button Content="Check-in" Click="OnCheckIn" />
            <Button Content="Check-out" Click="OnCheckOut" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Llegadas de hoy">
                <ListBox x:Name="LstLlegadas" DisplayMemberPath="Texto" SelectionChanged="OnSeleccion" />
            </GroupBox>
            <GroupBox Grid.Column="1" Header="En casa">
                <ListBox x:Name="LstEnCasa" DisplayMemberPath="Texto" SelectionChanged="OnSeleccion" />
            </GroupBox>
            <GroupBox Grid.Column="2" Header="Salidas de hoy">
                <ListBox x:Name="LstSalidas" DisplayMemberPath="Texto" SelectionChanged="OnSeleccion" />
            </GroupBox>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Detalle de la estancia">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Reserva" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtReserva" Grid.Column="1" IsReadOnly="True" />
                    <TextBlock Grid.Row="1" Text="Tipo de check-in" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1" />
                    <TextBlock Grid.Row="2" Text="Tipo de check-out" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="2" Grid.Column="1" />
                    <TextBlock Grid.Row="3" Text="Estado" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="3" Grid.Column="1" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Llaves de la estancia">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="GridLlaves" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" />
                            <DataGridTextColumn Header="Emitida" Binding="{Binding Emitida, StringFormat={}{0:g}}" />
                            <DataGridTextColumn Header="Devuelta" Binding="{Binding Devuelta, StringFormat={}{0:g}}" />
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <Button Content="Emitir llave" Click="OnEmitirLlave" />
                        <Button Content="Devolver llave" Click="OnDevolverLlave" />
                        <Button Content="Mover de habitación" Click="OnMoverHabitacion" />
                        <Button Content="Imprimir estancia" Click="OnImprimir" />
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
