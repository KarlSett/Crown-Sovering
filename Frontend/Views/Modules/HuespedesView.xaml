<UserControl x:Class="Crown__.Frontend.Views.Modules.HuespedesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Huéspedes" VerticalAlignment="Center" />
            <TextBlock Text="Buscar…" VerticalAlignment="Center" />
            <TextBox x:Name="TxtBuscar" Width="220" TextChanged="OnBuscarCambia" />
            <Button Content="Buscar" Click="OnBuscar" />
            <Button Content="Nuevo huésped" Click="OnNuevoHuesped" />
            <Button x:Name="BtnEditar" Content="Editar" Click="OnEditar" IsEnabled="False" />
            <Button x:Name="BtnEliminar" Content="Eliminar" Click="OnEliminar" IsEnabled="False" />
        </StackPanel>

        <TextBlock x:Name="TxtAviso" Grid.Row="1" Margin="0,4,0,4" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Huéspedes">
                <ListBox x:Name="ListaHuespedes" SelectionChanged="OnSeleccion" />
            </GroupBox>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox Header="Datos del huésped">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Nombre" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtNombre" Grid.Column="1" IsReadOnly="True" />
                        <TextBlock Grid.Column="2" Text="Apellidos" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtApellidos" Grid.Column="3" IsReadOnly="True" />
                        <TextBlock Grid.Row="1" Text="Documento" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtDocumento" Grid.Row="1" Grid.Column="1" IsReadOnly="True" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Correo" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtCorreo" Grid.Row="1" Grid.Column="3" IsReadOnly="True" />
                        <TextBlock Grid.Row="2" Text="Teléfono" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtTelefono" Grid.Row="2" Grid.Column="1" IsReadOnly="True" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Nacimiento" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtNacimiento" Grid.Row="2" Grid.Column="3" IsReadOnly="True" />
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="Consentimiento de datos">
                    <WrapPanel>
                        <TextBlock Text="Tipo" VerticalAlignment="Center" />
                        <ComboBox x:Name="CmbConsentimiento" Width="190" />
                        <CheckBox x:Name="ChkAutorizado" Content="Autorizado" VerticalAlignment="Center" />
                        <TextBlock Text="Fecha" VerticalAlignment="Center" />
                        <DatePicker x:Name="DpConsentimiento" />
                        <Button x:Name="BtnGuardarConsentimiento" Content="Guardar consentimiento" Click="OnGuardarConsentimiento" IsEnabled="False" />
                    </WrapPanel>
                </GroupBox>

                <GroupBox Grid.Row="2" Header="Historial de consentimientos">
                    <DataGrid x:Name="GridConsentimientos" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="2*" />
                            <DataGridTextColumn Header="Autorizado" Binding="{Binding AutorizadoTexto}" Width="*" />
                            <DataGridTextColumn Header="Fecha" Binding="{Binding FechaTexto}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
