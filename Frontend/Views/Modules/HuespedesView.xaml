<UserControl x:Class="Crown__.Frontend.Views.Modules.HuespedesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal">
            <TextBlock Text="Huéspedes" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Text="Buscar…" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="TxtBuscarHuesped" TextChanged="OnSearchChanged" Width="220" Margin="0,2,6,2" />
            <Button Content="Buscar" />
            <Button Content="Nuevo huésped" Click="OnNuevoHuesped" />
            <Button Content="Editar" />
            <Button Content="Eliminar" />
        </StackPanel></ScrollViewer>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Huéspedes">
                <ListBox x:Name="ListaHuespedes">
                    <ListBox.ItemTemplate><DataTemplate>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="28" Height="32" Background="{DynamicResource UI.Selection}" CornerRadius="8" VerticalAlignment="Center"><TextBlock Text="{Binding Initials}" Foreground="{DynamicResource UI.Text}" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding Guest.NombreCompleto}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Guest.Nacionalidad}" Foreground="{DynamicResource UI.Muted}" FontSize="10" Margin="0,4,0,0" /></StackPanel>
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox Header="Datos del huésped">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Nombre" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Column="1" Margin="0,2,6,2" Text="{Binding SelectedItem.Guest.Nombres, ElementName=ListaHuespedes, Mode=OneWay}" />
                        <TextBlock Grid.Column="2" Text="Apellidos" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Column="3" Margin="0,2,6,2" Text="{Binding SelectedItem.Guest.Apellidos, ElementName=ListaHuespedes, Mode=OneWay}" />
                        <TextBlock Grid.Row="1" Text="Documento" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2,6,2" Text="{Binding SelectedItem.Guest.NumeroDocumento, ElementName=ListaHuespedes, Mode=OneWay}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Correo" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Row="1" Grid.Column="3" Margin="0,2,6,2" Text="{Binding SelectedItem.Guest.Correo, ElementName=ListaHuespedes, Mode=OneWay}" />
                        <TextBlock Grid.Row="2" Text="Teléfono" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2,6,2" Text="{Binding SelectedItem.Guest.Telefono, ElementName=ListaHuespedes, Mode=OneWay}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Nacimiento" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <DatePicker Grid.Row="2" Grid.Column="3" />
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="Consentimiento de datos">
                    <WrapPanel>
                        <TextBlock Text="Tipo" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Width="150" Margin="0,2,6,2" />
                        <CheckBox Content="Autorizado" VerticalAlignment="Center" />
                        <TextBlock Text="Fecha" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <DatePicker />
                        <Button Content="Guardar consentimiento" />
                    </WrapPanel>
                </GroupBox>

                <GroupBox Grid.Row="2" Header="Historial de consentimientos">
                    <DataGrid AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tipo" />
                            <DataGridTextColumn Header="Autorizado" />
                            <DataGridTextColumn Header="Fecha" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
