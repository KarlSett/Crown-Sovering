<UserControl x:Class="Crown__.Frontend.Views.Modules.ReservasGestionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="OnLoaded">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal"><TextBlock Text="Reservas avanzadas" VerticalAlignment="Center"/><TextBox x:Name="TxtBuscar" Width="200" TextChanged="OnBuscar"/><ComboBox x:Name="CmbEstado" Width="140" SelectionChanged="OnBuscar"/><Button Content="Nueva reserva" Click="OnNuevaReserva"/><Button Content="Actualizar" Click="OnActualizar"/></StackPanel>
  <DataGrid x:Name="GridReservas" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="OnSeleccion"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding Codigo}"/><DataGridTextColumn Header="Huésped" Binding="{Binding Huesped}"/><DataGridTextColumn Header="Habitación" Binding="{Binding Habitacion}"/><DataGridTextColumn Header="Canal" Binding="{Binding Canal}"/><DataGridTextColumn Header="Entrada" Binding="{Binding Checkin}"/><DataGridTextColumn Header="Salida" Binding="{Binding Checkout}"/><DataGridTextColumn Header="Noches" Binding="{Binding Noches}"/><DataGridTextColumn Header="Total" Binding="{Binding Total}"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}"/></DataGrid.Columns></DataGrid>
  <StackPanel Grid.Row="2" Orientation="Horizontal"><TextBlock x:Name="TxtDetalle" VerticalAlignment="Center"/><Button Content="Check-in" Click="OnCheckIn"/><Button Content="Check-out" Click="OnCheckOut"/><Button Content="Cancelar" Click="OnCancelar"/></StackPanel>
 </Grid>
</UserControl>
