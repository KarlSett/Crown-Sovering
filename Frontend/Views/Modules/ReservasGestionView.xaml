<UserControl x:Class="Crown__.Frontend.Views.Modules.ReservasGestionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Reservas · administración" VerticalAlignment="Center" />
            <Button Content="Nueva reserva" Click="OnNuevaReserva" />
            <Button Content="Buscar disponibilidad" />
            <TextBlock Text="Canal" VerticalAlignment="Center" />
            <ComboBox Width="120" />
            <TextBlock Text="Estado" VerticalAlignment="Center" />
            <ComboBox Width="120" />
            <Button Content="Actualizar" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Lunes">
                <ListBox>
                    <ListBoxItem Content="CS-001 · Huésped" />
                    <ListBoxItem Content="CS-002 · Huésped" />
                </ListBox>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="Martes">
                <ListBox>
                    <ListBoxItem Content="CS-003 · Huésped" />
                    <ListBoxItem Content="CS-004 · Huésped" />
                </ListBox>
            </GroupBox>
            <GroupBox Grid.Column="2" Header="Miércoles">
                <ListBox>
                    <ListBoxItem Content="CS-005 · Huésped" />
                </ListBox>
            </GroupBox>
            <GroupBox Grid.Column="3" Header="Jueves">
                <ListBox>
                    <ListBoxItem Content="CS-006 · Huésped" />
                    <ListBoxItem Content="CS-007 · Huésped" />
                </ListBox>
            </GroupBox>
            <GroupBox Grid.Column="4" Header="Viernes">
                <ListBox>
                    <ListBoxItem Content="CS-008 · Huésped" />
                    <ListBoxItem Content="CS-009 · Huésped" />
                </ListBox>
            </GroupBox>
            <GroupBox Grid.Column="5" Header="Sábado">
                <ListBox>
                    <ListBoxItem Content="CS-010 · Huésped" />
                </ListBox>
            </GroupBox>
            <GroupBox Grid.Column="6" Header="Domingo">
                <ListBox>
                    <ListBoxItem Content="CS-011 · Huésped" />
                </ListBox>
            </GroupBox>
        </Grid>

        <TabControl Grid.Row="2">
            <TabItem Header="Detalle de la reserva">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <GroupBox Header="Datos">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Huésped principal" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" />
                            <TextBlock Grid.Row="1" Text="Canal" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="1" Grid.Column="1" />
                            <TextBlock Grid.Row="2" Text="Entrada" VerticalAlignment="Center" />
                            <DatePicker Grid.Row="2" Grid.Column="1" />
                            <TextBlock Grid.Row="3" Text="Salida" VerticalAlignment="Center" />
                            <DatePicker Grid.Row="3" Grid.Column="1" />
                        </Grid>
                    </GroupBox>
                    <GroupBox Grid.Column="1" Header="Huéspedes y habitaciones">
                        <TabControl>
                            <TabItem Header="Huéspedes">
                                <DataGrid AutoGenerateColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Huésped" />
                                        <DataGridTextColumn Header="Principal" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Habitaciones">
                                <DataGrid AutoGenerateColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Habitación" />
                                        <DataGridTextColumn Header="Entrada" />
                                        <DataGridTextColumn Header="Salida" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Solicitudes y recursos">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <ListBox>
                                        <ListBoxItem Content="Solicitud especial" />
                                    </ListBox>
                                    <DataGrid Grid.Row="1" AutoGenerateColumns="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Recurso" />
                                            <DataGridTextColumn Header="Cantidad" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Canales">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Nombre" VerticalAlignment="Center" />
                        <TextBox Width="180" />
                        <TextBlock Text="Comisión" VerticalAlignment="Center" />
                        <TextBox Width="80" />
                        <Button Content="Guardar" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Canal" />
                            <DataGridTextColumn Header="Comisión" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Grupos">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Nombre" VerticalAlignment="Center" />
                        <TextBox Width="200" />
                        <Button Content="Guardar" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Grupo" />
                            <DataGridTextColumn Header="Creado" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Lista de espera">
                <DataGrid AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Huésped" />
                        <DataGridTextColumn Header="Tipo de habitación" />
                        <DataGridTextColumn Header="Desde" />
                        <DataGridTextColumn Header="Hasta" />
                        <DataGridTextColumn Header="Estado" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
