<UserControl x:Class="Crown__.Frontend.Views.Modules.ReservasGestionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="OnLoaded" SizeChanged="OnWorkspaceSizeChanged">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="DetailRow" Height="300" />
        </Grid.RowDefinitions>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal">
            <TextBlock x:Name="TxtSemana" Text="Agenda semanal" Width="132" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button Content="Nueva reserva" Click="OnNuevaReserva" />
            <Button Content="Buscar disponibilidad" />
            <TextBlock Text="Canal" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="CmbCanalAgenda" Width="120" Margin="0,2,6,2" SelectionChanged="OnFilterChanged" />
            <TextBlock Text="Estado" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="CmbEstadoAgenda" Width="120" Margin="0,2,6,2" SelectionChanged="OnFilterChanged" />
            <Button Content="Actualizar" Click="OnRefresh" />
        </StackPanel></ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource UI.Surface}" BorderBrush="{DynamicResource UI.Border}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,10,8,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="AgendaSemana" MinWidth="882" ItemTemplate="{StaticResource ReservationDayTemplate}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="Detalle de la reserva">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <GroupBox x:Name="CardReservaDetalle" Header="Detalle de la reserva">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Huésped principal" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="CmbHuespedDetalle" Grid.Column="1" Margin="0,2,6,2" />
                            <TextBlock Grid.Row="1" Text="Canal" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="CmbCanalDetalle" Grid.Row="1" Grid.Column="1" Margin="0,2,6,2" />
                            <TextBlock Grid.Row="2" Text="Entrada" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <DatePicker x:Name="DpEntradaDetalle" Grid.Row="2" Grid.Column="1" />
                            <TextBlock Grid.Row="3" Text="Salida" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <DatePicker x:Name="DpSalidaDetalle" Grid.Row="3" Grid.Column="1" />
                        </Grid>
                        </ScrollViewer>
                    </GroupBox>
                    <GroupBox Grid.Column="1" Header="Huéspedes y habitaciones">
                        <TabControl Style="{StaticResource InlineTabs}">
                            <TabItem Header="Huéspedes">
                                <DataGrid x:Name="GridHuespedesDetalle" AutoGenerateColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Huésped" Binding="{Binding Nombre}" Width="*" MinWidth="150" />
                                        <DataGridTextColumn Header="Principal" Binding="{Binding Principal}" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Habitaciones">
                                <DataGrid x:Name="GridHabitacionesDetalle" AutoGenerateColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Habitación" Binding="{Binding Habitacion}" />
                                        <DataGridTextColumn Header="Entrada" Binding="{Binding Checkin}" />
                                        <DataGridTextColumn Header="Salida" Binding="{Binding Checkout}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Solicitudes y recursos">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <ListBox>
                                        <ListBoxItem Content="Solicitud especial" />
                                    </ListBox>
                                    <DataGrid Grid.Row="1" AutoGenerateColumns="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Recurso" />
                                            <DataGridTextColumn Header="Cantidad" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Canales">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal">
                        <TextBlock Text="Nombre" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="180" Margin="0,2,6,2" />
                        <TextBlock Text="Comisión" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="80" Margin="0,2,6,2" />
                        <Button Content="Guardar" />
                    </StackPanel></ScrollViewer>
                    <DataGrid Grid.Row="1" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Canal" />
                            <DataGridTextColumn Header="Comisión" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Grupos">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal">
                        <TextBlock Text="Nombre" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="200" Margin="0,2,6,2" />
                        <Button Content="Guardar" />
                    </StackPanel></ScrollViewer>
                    <DataGrid Grid.Row="1" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Grupo" />
                            <DataGridTextColumn Header="Creado" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Lista de espera">
                <DataGrid AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Huésped" />
                        <DataGridTextColumn Header="Tipo de habitación" />
                        <DataGridTextColumn Header="Desde" />
                        <DataGridTextColumn Header="Hasta" />
                        <DataGridTextColumn Header="Estado" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
