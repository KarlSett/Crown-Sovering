<UserControl x:Class="Crown__.Frontend.Views.Modules.ReservasGestionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Reservas · administración" VerticalAlignment="Center" />
            <Button Content="Nueva reserva" Click="OnNuevaReserva" />
            <Button Content="◀ Semana" Click="OnSemanaAnterior" />
            <TextBlock x:Name="TxtSemana" VerticalAlignment="Center" />
            <Button Content="Semana ▶" Click="OnSemanaSiguiente" />
            <TextBlock Text="Canal" VerticalAlignment="Center" />
            <ComboBox x:Name="CmbCanal" Width="120" />
            <TextBlock Text="Estado" VerticalAlignment="Center" />
            <ComboBox x:Name="CmbEstado" Width="120" />
            <Button Content="Actualizar" Click="OnActualizar" />
        </StackPanel>

        <TextBlock x:Name="TxtAviso" Grid.Row="1" Margin="0,4,0,4" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox x:Name="Dia0"><ListBox x:Name="Lista0" SelectionChanged="OnSeleccion" /></GroupBox>
            <GroupBox x:Name="Dia1" Grid.Column="1"><ListBox x:Name="Lista1" SelectionChanged="OnSeleccion" /></GroupBox>
            <GroupBox x:Name="Dia2" Grid.Column="2"><ListBox x:Name="Lista2" SelectionChanged="OnSeleccion" /></GroupBox>
            <GroupBox x:Name="Dia3" Grid.Column="3"><ListBox x:Name="Lista3" SelectionChanged="OnSeleccion" /></GroupBox>
            <GroupBox x:Name="Dia4" Grid.Column="4"><ListBox x:Name="Lista4" SelectionChanged="OnSeleccion" /></GroupBox>
            <GroupBox x:Name="Dia5" Grid.Column="5"><ListBox x:Name="Lista5" SelectionChanged="OnSeleccion" /></GroupBox>
            <GroupBox x:Name="Dia6" Grid.Column="6"><ListBox x:Name="Lista6" SelectionChanged="OnSeleccion" /></GroupBox>
        </Grid>

        <TabControl Grid.Row="3">
            <TabItem Header="Detalle de la reserva">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <GroupBox Header="Datos">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Huésped principal" VerticalAlignment="Center" />
                            <TextBox x:Name="TxtHuesped" Grid.Column="1" IsReadOnly="True" />
                            <TextBlock Grid.Row="1" Text="Canal" VerticalAlignment="Center" />
                            <TextBox x:Name="TxtCanal" Grid.Row="1" Grid.Column="1" IsReadOnly="True" />
                            <TextBlock Grid.Row="2" Text="Entrada" VerticalAlignment="Center" />
                            <TextBox x:Name="TxtEntrada" Grid.Row="2" Grid.Column="1" IsReadOnly="True" />
                            <TextBlock Grid.Row="3" Text="Salida" VerticalAlignment="Center" />
                            <TextBox x:Name="TxtSalida" Grid.Row="3" Grid.Column="1" IsReadOnly="True" />
                            <TextBlock Grid.Row="4" Text="Estado" VerticalAlignment="Center" />
                            <TextBox x:Name="TxtEstado" Grid.Row="4" Grid.Column="1" IsReadOnly="True" />
                        </Grid>
                    </GroupBox>
                    <GroupBox Grid.Column="1" Header="Huéspedes y habitaciones">
                        <TabControl>
                            <TabItem Header="Huéspedes"><ListBox x:Name="ListaHuespedes" /></TabItem>
                            <TabItem Header="Habitaciones"><ListBox x:Name="ListaHabitaciones" /></TabItem>
                            <TabItem Header="Solicitudes y recursos">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <ListBox x:Name="ListaSolicitudes" />
                                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                                        <TextBox x:Name="TxtSolicitud" Width="220" />
                                        <Button Content="Solicitud especial" Click="OnSolicitud" />
                                    </StackPanel>
                                    <ListBox x:Name="ListaRecursos" Grid.Row="2" />
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Canales">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Nombre" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtCanalNombre" Width="180" />
                        <TextBlock Text="Comisión (%)" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtCanalComision" Width="80" Text="0" />
                        <Button Content="Guardar" Click="OnGuardarCanal" />
                    </StackPanel>
                    <DataGrid x:Name="GridCanales" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Canal" Binding="{Binding Nombre}" Width="*" />
                            <DataGridTextColumn Header="Comisión" Binding="{Binding ComisionTexto}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Grupos">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Nombre" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtGrupoNombre" Width="200" />
                        <Button Content="Guardar" Click="OnGuardarGrupo" />
                    </StackPanel>
                    <DataGrid x:Name="GridGrupos" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Grupo" Binding="{Binding Nombre}" Width="*" />
                            <DataGridTextColumn Header="Creado" Binding="{Binding CreadoTexto}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Lista de espera">
                <DataGrid x:Name="GridEspera" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Huésped" Binding="{Binding Huesped}" Width="2*" />
                        <DataGridTextColumn Header="Tipo de habitación" Binding="{Binding TipoHabitacion}" Width="*" />
                        <DataGridTextColumn Header="Desde" Binding="{Binding DesdeTexto}" Width="*" />
                        <DataGridTextColumn Header="Hasta" Binding="{Binding HastaTexto}" Width="*" />
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
