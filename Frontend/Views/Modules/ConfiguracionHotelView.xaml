<UserControl x:Class="Crown__.Frontend.Views.Modules.ConfiguracionHotelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TabControl TabStripPlacement="Left">
        <TabItem Header="Hotel">
            <GroupBox Header="Datos del hotel">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Nombre" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" Margin="0,2,6,2" />
                    <TextBlock Grid.Column="2" Text="Categoría" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Grid.Column="3" Margin="0,2,6,2" />
                    <TextBlock Grid.Row="1" Text="Dirección" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2,6,2" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Teléfono" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Row="1" Grid.Column="3" Margin="0,2,6,2" />
                    <TextBlock Grid.Row="2" Text="Correo" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2,6,2" />
                    <TextBlock Grid.Row="3" Text="Moneda" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,2,6,2" />
                    <Button Grid.Row="3" Grid.Column="3" Content="Guardar" />
                </Grid>
            </GroupBox>
        </TabItem>

        <TabItem Header="Parámetros">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <WrapPanel>
                    <TextBlock Text="Clave" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Width="160" Margin="0,2,6,2" />
                    <TextBlock Text="Valor" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Width="240" Margin="0,2,6,2" />
                    <Button Content="Guardar" />
                </WrapPanel>
                <DataGrid Grid.Row="1" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Clave" />
                        <DataGridTextColumn Header="Valor" />
                        <DataGridTextColumn Header="Actualizado" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem Header="Políticas">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <WrapPanel>
                    <TextBlock Text="Nombre" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Width="160" Margin="0,2,6,2" />
                    <TextBlock Text="Valor" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Width="180" Margin="0,2,6,2" />
                    <TextBlock Text="Descripción" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Width="200" Margin="0,2,6,2" />
                    <Button Content="Guardar" />
                </WrapPanel>
                <DataGrid Grid.Row="1" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre" />
                        <DataGridTextColumn Header="Valor" />
                        <DataGridTextColumn Header="Descripción" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem Header="Impuestos">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <WrapPanel>
                    <TextBlock Text="Nombre" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Width="160" Margin="0,2,6,2" />
                    <TextBlock Text="Porcentaje" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Width="80" Margin="0,2,6,2" />
                    <CheckBox Content="Activo" VerticalAlignment="Center" />
                    <Button Content="Guardar" />
                </WrapPanel>
                <DataGrid Grid.Row="1" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre" />
                        <DataGridTextColumn Header="Porcentaje" />
                        <DataGridTextColumn Header="Activo" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem Header="Módulos">
            <GroupBox Header="Módulos contratados">
                <DataGrid AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Módulo" />
                        <DataGridTextColumn Header="Descripción" />
                        <DataGridTextColumn Header="Activo" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </TabItem>

        <TabItem Header="Auditoría">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <WrapPanel>
                    <TextBlock Text="Usuario" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Width="150" Margin="0,2,6,2" />
                    <TextBlock Text="Desde" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <DatePicker />
                    <TextBlock Text="Hasta" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <DatePicker />
                    <Button Content="Buscar" />
                </WrapPanel>
                <DataGrid Grid.Row="1" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" />
                        <DataGridTextColumn Header="Usuario" />
                        <DataGridTextColumn Header="Cambio" />
                        <DataGridTextColumn Header="Valor anterior" />
                        <DataGridTextColumn Header="Valor nuevo" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
