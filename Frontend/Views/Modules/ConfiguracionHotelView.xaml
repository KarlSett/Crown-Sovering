<UserControl x:Class="Crown__.Frontend.Views.Modules.ConfiguracionHotelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <TabControl TabStripPlacement="Left">
        <TabItem Header="Hotel">
            <GroupBox Header="Datos del hotel">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Nombre" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtNombre" Grid.Column="1" />
                    <TextBlock Grid.Column="2" Text="Categoría (estrellas)" VerticalAlignment="Center" />
                    <ComboBox x:Name="CmbCategoria" Grid.Column="3" />
                    <TextBlock Grid.Row="1" Text="Dirección" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtDireccion" Grid.Row="1" Grid.Column="1" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Teléfono" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtTelefono" Grid.Row="1" Grid.Column="3" />
                    <TextBlock Grid.Row="2" Text="Correo" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtCorreo" Grid.Row="2" Grid.Column="1" />
                    <TextBlock Grid.Row="3" Text="Moneda" VerticalAlignment="Center" />
                    <ComboBox x:Name="CmbMoneda" Grid.Row="3" Grid.Column="1" />
                    <Button Grid.Row="3" Grid.Column="3" Content="Guardar" Click="OnGuardarHotel" />
                    <TextBlock x:Name="TxtAviso" Grid.Row="4" Grid.ColumnSpan="4" Margin="0,8,0,0" />
                </Grid>
            </GroupBox>
        </TabItem>

        <TabItem Header="Parámetros">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <WrapPanel>
                    <TextBlock Text="Clave" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtClave" Width="160" />
                    <TextBlock Text="Valor" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtValor" Width="240" />
                    <Button Content="Guardar" Click="OnGuardarParametro" />
                </WrapPanel>
                <DataGrid x:Name="GridParametros" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Clave" Binding="{Binding Clave}" Width="*" />
                        <DataGridTextColumn Header="Valor" Binding="{Binding Valor}" Width="2*" />
                        <DataGridTextColumn Header="Actualizado" Binding="{Binding ActualizadoTexto}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem Header="Políticas">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <WrapPanel>
                    <TextBlock Text="Nombre" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtPoliticaNombre" Width="160" />
                    <TextBlock Text="Valor" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtPoliticaValor" Width="180" />
                    <TextBlock Text="Descripción" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtPoliticaDescripcion" Width="200" />
                    <Button Content="Guardar" Click="OnGuardarPolitica" />
                </WrapPanel>
                <DataGrid x:Name="GridPoliticas" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
                        <DataGridTextColumn Header="Valor" Binding="{Binding Valor}" Width="*" />
                        <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem Header="Impuestos">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <WrapPanel>
                    <TextBlock Text="Nombre" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtImpuestoNombre" Width="160" />
                    <TextBlock Text="Porcentaje" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtImpuestoPorcentaje" Width="80" />
                    <CheckBox x:Name="ChkImpuestoActivo" Content="Activo" IsChecked="True" VerticalAlignment="Center" />
                    <Button Content="Guardar" Click="OnGuardarImpuesto" />
                </WrapPanel>
                <DataGrid x:Name="GridImpuestos" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
                        <DataGridTextColumn Header="Porcentaje" Binding="{Binding PorcentajeTexto}" Width="*" />
                        <DataGridTextColumn Header="Activo" Binding="{Binding ActivoTexto}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem Header="Módulos">
            <GroupBox Header="Módulos contratados">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <Button Content="Activar" Click="OnActivarModulo" />
                        <Button Content="Desactivar" Click="OnDesactivarModulo" />
                    </WrapPanel>
                    <DataGrid x:Name="GridModulos" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Módulo" Binding="{Binding Nombre}" Width="*" />
                            <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="2*" />
                            <DataGridTextColumn Header="Activo" Binding="{Binding ActivoTexto}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>
        </TabItem>

        <TabItem Header="Auditoría">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <WrapPanel>
                    <TextBlock Text="Usuario" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtAuditoriaUsuario" Width="150" />
                    <TextBlock Text="Desde" VerticalAlignment="Center" />
                    <DatePicker x:Name="DpAuditoriaDesde" />
                    <TextBlock Text="Hasta" VerticalAlignment="Center" />
                    <DatePicker x:Name="DpAuditoriaHasta" />
                    <Button Content="Buscar" Click="OnBuscarAuditoria" />
                </WrapPanel>
                <DataGrid x:Name="GridAuditoria" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding FechaTexto}" Width="*" />
                        <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="*" />
                        <DataGridTextColumn Header="Cambio" Binding="{Binding Cambio}" Width="2*" />
                        <DataGridTextColumn Header="Valor anterior" Binding="{Binding Anterior}" Width="*" />
                        <DataGridTextColumn Header="Valor nuevo" Binding="{Binding Nuevo}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
