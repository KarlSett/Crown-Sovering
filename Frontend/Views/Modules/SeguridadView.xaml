<UserControl x:Class="Crown__.Frontend.Views.Modules.SeguridadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Expander Header="Usuarios" IsExpanded="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="200" />
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <TextBlock Text="Usuario" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="120" Margin="0,2,6,2" />
                        <TextBlock Text="Empleado" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Width="170" Margin="0,2,6,2" />
                        <TextBlock Text="Contraseña" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <PasswordBox Width="130" />
                        <TextBlock Text="Estado" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Width="110" Margin="0,2,6,2" />
                        <Button Content="Guardar" />
                    </WrapPanel>
                    <DataGrid Grid.Row="1" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Usuario" />
                            <DataGridTextColumn Header="Empleado" />
                            <DataGridTextColumn Header="Roles" />
                            <DataGridTextColumn Header="Estado" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Expander>

            <Expander Header="Empleados">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="180" />
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <TextBlock Text="Nombre" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="140" Margin="0,2,6,2" />
                        <TextBlock Text="Apellido" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="140" Margin="0,2,6,2" />
                        <TextBlock Text="Correo" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="170" Margin="0,2,6,2" />
                        <TextBlock Text="Teléfono" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="120" Margin="0,2,6,2" />
                        <Button Content="Guardar" />
                    </WrapPanel>
                    <DataGrid Grid.Row="1" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre" />
                            <DataGridTextColumn Header="Apellido" />
                            <DataGridTextColumn Header="Correo" />
                            <DataGridTextColumn Header="Teléfono" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Expander>

            <Expander Header="Roles">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="180" />
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <TextBlock Text="Nombre" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="160" Margin="0,2,6,2" />
                        <TextBlock Text="Descripción" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="240" Margin="0,2,6,2" />
                        <Button Content="Guardar" />
                    </WrapPanel>
                    <DataGrid Grid.Row="1" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Rol" />
                            <DataGridTextColumn Header="Descripción" />
                            <DataGridTextColumn Header="Usuarios" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Expander>

            <Expander Header="Asignación de roles">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="180" />
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <TextBlock Text="Usuario" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Width="170" Margin="0,2,6,2" />
                        <TextBlock Text="Rol" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Width="140" Margin="0,2,6,2" />
                        <Button Content="Asignar" />
                    </WrapPanel>
                    <DataGrid Grid.Row="1" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Usuario" />
                            <DataGridTextColumn Header="Rol" />
                            <DataGridTextColumn Header="Acciones" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
