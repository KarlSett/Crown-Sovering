<UserControl x:Class="Crown__.Frontend.Views.Modules.SeguridadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Expander Header="Usuarios" IsExpanded="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="200" />
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <TextBlock Text="Usuario" VerticalAlignment="Center" />
                        <TextBox Width="120" />
                        <TextBlock Text="Empleado" VerticalAlignment="Center" />
                        <ComboBox Width="170" />
                        <TextBlock Text="Contraseña" VerticalAlignment="Center" />
                        <PasswordBox Width="130" />
                        <TextBlock Text="Estado" VerticalAlignment="Center" />
                        <ComboBox Width="110" />
                        <Button Content="Usuarios: requiere autenticación" IsEnabled="False" ToolTip="Definir política de contraseñas y proveedor de identidad antes de crear cuentas" />
                    </WrapPanel>
                    <DataGrid Grid.Row="1" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Usuario" />
                            <DataGridTextColumn Header="Empleado" />
                            <DataGridTextColumn Header="Roles" />
                            <DataGridTextColumn Header="Estado" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Expander>

            <Expander Header="Empleados">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="180" />
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <TextBlock Text="Nombre" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtNombreEmpleado" Width="140" />
                        <TextBlock Text="Apellido" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtApellidoEmpleado" Width="140" />
                        <TextBlock Text="Correo" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtCorreoEmpleado" Width="170" />
                        <TextBlock Text="Teléfono" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtTelefonoEmpleado" Width="120" />
                        <Button Content="Guardar" Click="OnGuardarEmpleado" />
                    </WrapPanel>
                    <DataGrid x:Name="GridEmpleados" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" />
                            <DataGridTextColumn Header="Apellido" Binding="{Binding Apellido}" />
                            <DataGridTextColumn Header="Correo" Binding="{Binding Correo}" />
                            <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Expander>

            <Expander Header="Roles">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="180" />
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <TextBlock Text="Nombre" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtRolNombre" Width="160" />
                        <TextBlock Text="Descripción" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtRolDescripcion" Width="240" />
                        <Button Content="Guardar" Click="OnGuardarRol" />
                    </WrapPanel>
                    <DataGrid x:Name="GridRoles" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Rol" Binding="{Binding Nombre}" />
                            <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" />
                            <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Expander>

            <Expander Header="Asignación de roles">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="180" />
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <TextBlock Text="Usuario" VerticalAlignment="Center" />
                        <ComboBox x:Name="CmbEmpleado" Width="170" DisplayMemberPath="NombreCompleto" />
                        <TextBlock Text="Rol" VerticalAlignment="Center" />
                        <ComboBox x:Name="CmbRol" Width="140" DisplayMemberPath="Nombre" />
                        <Button Content="Asignar" Click="OnAsignarRol" />
                    </WrapPanel>
                    <DataGrid x:Name="GridAsignaciones" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Empleado" Binding="{Binding Empleado}" />
                            <DataGridTextColumn Header="Rol" Binding="{Binding Rol}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
