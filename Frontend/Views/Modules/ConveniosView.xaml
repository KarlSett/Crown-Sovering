<UserControl x:Class="Crown__.Frontend.Views.Modules.ConveniosView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="OnLoaded">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal"><TextBlock Text="Convenios corporativos" VerticalAlignment="Center"/><Button Content="Nuevo convenio" Click="OnNuevo"/><Button Content="Actualizar" Click="OnActualizar"/></StackPanel>
  <GroupBox Grid.Row="1" Header="Convenios activos"><ScrollViewer HorizontalScrollBarVisibility="Auto"><ItemsControl x:Name="ListaConvenios"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><GroupBox Header="{Binding Nombre}" Width="230" Margin="5"><StackPanel><TextBlock Text="{Binding Empresa}"/><TextBlock Text="Tarifa: {Binding TarifaPreferencial}"/><TextBlock Text="Límite: {Binding LimiteCredito}"/><TextBlock Text="Vence: {Binding Vencimiento, StringFormat={}{0:d}}"/><StackPanel Orientation="Horizontal"><Button Content="Editar" Tag="{Binding}" Click="OnEditar"/><Button Content="Reservas" Tag="{Binding}" Click="OnReservas"/></StackPanel></StackPanel></GroupBox></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></GroupBox>
  <TabControl x:Name="TabsConvenios" Grid.Row="2"><TabItem Header="Reservas asociadas"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Button Content="Asociar reserva seleccionada" Click="OnAsociarReserva" HorizontalAlignment="Left"/><DataGrid x:Name="GridReservas" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Reserva" Binding="{Binding CodigoReserva}"/><DataGridTextColumn Header="Huésped" Binding="{Binding HuespedId}"/><DataGridTextColumn Header="Entrada" Binding="{Binding FechaCheckinEsperado, StringFormat={}{0:d}}"/><DataGridTextColumn Header="Salida" Binding="{Binding FechaCheckoutEsperado, StringFormat={}{0:d}}"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}"/></DataGrid.Columns></DataGrid></Grid></TabItem>
   <TabItem Header="Historial de saldos"><DataGrid x:Name="GridSaldos" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Convenio" Binding="{Binding Nombre}"/><DataGridTextColumn Header="Crédito" Binding="{Binding LimiteCredito}"/><DataGridTextColumn Header="Estado" Binding="{Binding Activo}"/><DataGridTextColumn Header="Vencimiento" Binding="{Binding Vencimiento, StringFormat={}{0:d}}"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="Nuevo convenio"><WrapPanel><TextBlock Text="Nombre" VerticalAlignment="Center"/><TextBox x:Name="TxtNombre" Width="140"/><TextBlock Text="Empresa" VerticalAlignment="Center"/><TextBox x:Name="TxtEmpresa" Width="170"/><TextBlock Text="Tarifa preferencial" VerticalAlignment="Center"/><TextBox x:Name="TxtTarifa" Width="90"/><TextBlock Text="Límite de crédito" VerticalAlignment="Center"/><TextBox x:Name="TxtLimite" Width="90"/><TextBlock Text="Vencimiento" VerticalAlignment="Center"/><DatePicker x:Name="DpVence"/><Button Content="Guardar" Click="OnGuardar"/></WrapPanel></TabItem>
  </TabControl>
 </Grid>
</UserControl>
