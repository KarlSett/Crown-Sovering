<UserControl x:Class="Crown__.Frontend.Views.Modules.ConveniosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Convenios corporativos" VerticalAlignment="Center" />
            <Button Content="Nuevo convenio" />
            <Button Content="Actualizar" />
        </StackPanel>

        <GroupBox Grid.Row="1" Header="Convenios activos">
            <WrapPanel>
                <GroupBox Header="Convenio">
                    <StackPanel>
                        <TextBlock Text="Empresa" />
                        <TextBlock Text="Tarifa preferencial" />
                        <TextBlock Text="Límite de crédito" />
                        <TextBlock Text="Vence" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Editar" />
                            <Button Content="Reservas" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Convenio">
                    <StackPanel>
                        <TextBlock Text="Empresa" />
                        <TextBlock Text="Tarifa preferencial" />
                        <TextBlock Text="Límite de crédito" />
                        <TextBlock Text="Vence" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Editar" />
                            <Button Content="Reservas" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Convenio">
                    <StackPanel>
                        <TextBlock Text="Empresa" />
                        <TextBlock Text="Tarifa preferencial" />
                        <TextBlock Text="Límite de crédito" />
                        <TextBlock Text="Vence" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Editar" />
                            <Button Content="Reservas" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </WrapPanel>
        </GroupBox>

        <TabControl Grid.Row="2">
            <TabItem Header="Reservas asociadas">
                <DataGrid AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Reserva" />
                        <DataGridTextColumn Header="Huésped" />
                        <DataGridTextColumn Header="Entrada" />
                        <DataGridTextColumn Header="Salida" />
                        <DataGridTextColumn Header="Estado" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Historial de saldos">
                <DataGrid AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Convenio" />
                        <DataGridTextColumn Header="Saldo" />
                        <DataGridTextColumn Header="Descripción" />
                        <DataGridTextColumn Header="Fecha" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Nuevo convenio">
                <WrapPanel>
                    <TextBlock Text="Nombre" VerticalAlignment="Center" />
                    <TextBox Width="140" />
                    <TextBlock Text="Empresa" VerticalAlignment="Center" />
                    <TextBox Width="170" />
                    <TextBlock Text="Tarifa preferencial" VerticalAlignment="Center" />
                    <TextBox Width="90" />
                    <TextBlock Text="Límite de crédito" VerticalAlignment="Center" />
                    <TextBox Width="90" />
                    <TextBlock Text="Vencimiento" VerticalAlignment="Center" />
                    <DatePicker />
                    <Button Content="Guardar" />
                </WrapPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
