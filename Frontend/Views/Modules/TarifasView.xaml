<UserControl x:Class="Crown__.Frontend.Views.Modules.TarifasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dialogs="clr-namespace:Crown__.Frontend.Views.Dialogs">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal">
            <TextBlock Text="Tarifas y promociones" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button dialogs:DialogLauncher.Action="new-rate" Content="Nueva tarifa" />
            <Button dialogs:DialogLauncher.Action="new-season" Content="Nueva temporada" />
            <Button dialogs:DialogLauncher.Action="new-promotion" Content="Nueva promoción" />
        </StackPanel></ScrollViewer>

        <GroupBox Grid.Row="1" Header="Matriz de tarifas por tipo y temporada">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Tipo de habitación" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="Temporada alta" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="2" Text="Temporada media" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="3" Text="Temporada baja" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Row="1" Text="Sencilla" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2,6,2" />
                <TextBox Grid.Row="1" Grid.Column="2" Margin="0,2,6,2" />
                <TextBox Grid.Row="1" Grid.Column="3" Margin="0,2,6,2" />
                <TextBlock Grid.Row="2" Text="Doble" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2,6,2" />
                <TextBox Grid.Row="2" Grid.Column="2" Margin="0,2,6,2" />
                <TextBox Grid.Row="2" Grid.Column="3" Margin="0,2,6,2" />
                <TextBlock Grid.Row="3" Text="Familiar" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,2,6,2" />
                <TextBox Grid.Row="3" Grid.Column="2" Margin="0,2,6,2" />
                <TextBox Grid.Row="3" Grid.Column="3" Margin="0,2,6,2" />
                <TextBlock Grid.Row="4" Text="Suite" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Row="4" Grid.Column="1" Margin="0,2,6,2" />
                <TextBox Grid.Row="4" Grid.Column="2" Margin="0,2,6,2" />
                <TextBox Grid.Row="4" Grid.Column="3" Margin="0,2,6,2" />
            </Grid>
        </GroupBox>

        <TabControl Grid.Row="2">
            <TabItem Header="Temporadas">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <TextBlock Text="Nombre" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="160" Margin="0,2,6,2" />
                        <TextBlock Text="Inicio" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <DatePicker />
                        <TextBlock Text="Fin" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <DatePicker />
                        <Button Content="Guardar" />
                    </WrapPanel>
                    <DataGrid Grid.Row="1" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Temporada" />
                            <DataGridTextColumn Header="Inicio" />
                            <DataGridTextColumn Header="Fin" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Paquetes">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <TextBlock Text="Nombre" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="160" Margin="0,2,6,2" />
                        <TextBlock Text="Descripción" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="220" Margin="0,2,6,2" />
                        <TextBlock Text="Precio" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="90" Margin="0,2,6,2" />
                        <Button Content="Guardar" />
                    </WrapPanel>
                    <DataGrid Grid.Row="1" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Paquete" />
                            <DataGridTextColumn Header="Descripción" />
                            <DataGridTextColumn Header="Precio" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Promociones">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <TextBlock Text="Nombre" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="160" Margin="0,2,6,2" />
                        <TextBlock Text="Descuento (%)" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="80" Margin="0,2,6,2" />
                        <TextBlock Text="Inicio" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <DatePicker />
                        <TextBlock Text="Fin" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <DatePicker />
                        <CheckBox Content="Activa" VerticalAlignment="Center" />
                        <Button Content="Guardar" />
                    </WrapPanel>
                    <DataGrid Grid.Row="1" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Promoción" />
                            <DataGridTextColumn Header="Descuento" />
                            <DataGridTextColumn Header="Inicio" />
                            <DataGridTextColumn Header="Fin" />
                            <DataGridTextColumn Header="Estado" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Precios por canal">
                <DataGrid AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tarifa" />
                        <DataGridTextColumn Header="Temporada" />
                        <DataGridTextColumn Header="Canal" />
                        <DataGridTextColumn Header="Precio" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
