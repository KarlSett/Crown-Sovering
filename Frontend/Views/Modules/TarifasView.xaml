<UserControl x:Class="Crown__.Frontend.Views.Modules.TarifasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Tarifas y promociones" VerticalAlignment="Center" />
            <Button Content="Nueva tarifa" Click="OnNuevaTarifa" />
            <Button Content="Nueva temporada" Click="OnNuevaTemporada" />
            <Button Content="Nueva promoción" Click="OnNuevaPromocion" />
        </StackPanel>

        <GroupBox Grid.Row="1" Header="Matriz de tarifas por tipo y temporada">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Tipo de habitación" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Temporada alta" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="Temporada media" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="Temporada baja" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Text="Sencilla" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" />
                <TextBox Grid.Row="1" Grid.Column="2" />
                <TextBox Grid.Row="1" Grid.Column="3" />
                <TextBlock Grid.Row="2" Text="Doble" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" />
                <TextBox Grid.Row="2" Grid.Column="2" />
                <TextBox Grid.Row="2" Grid.Column="3" />
                <TextBlock Grid.Row="3" Text="Familiar" VerticalAlignment="Center" />
                <TextBox Grid.Row="3" Grid.Column="1" />
                <TextBox Grid.Row="3" Grid.Column="2" />
                <TextBox Grid.Row="3" Grid.Column="3" />
                <TextBlock Grid.Row="4" Text="Suite" VerticalAlignment="Center" />
                <TextBox Grid.Row="4" Grid.Column="1" />
                <TextBox Grid.Row="4" Grid.Column="2" />
                <TextBox Grid.Row="4" Grid.Column="3" />
            </Grid>
        </GroupBox>

        <TabControl x:Name="TabsTarifas" Grid.Row="2">
            <TabItem Header="Temporadas">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <TextBlock Text="Nombre" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtTemporada" Width="160" />
                        <TextBlock Text="Inicio" VerticalAlignment="Center" />
                        <DatePicker x:Name="DpTemporadaInicio" />
                        <TextBlock Text="Fin" VerticalAlignment="Center" />
                        <DatePicker x:Name="DpTemporadaFin" />
                        <Button Content="Guardar" Click="OnGuardarTemporada" />
                    </WrapPanel>
                    <DataGrid x:Name="GridTemporadas" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Temporada" Binding="{Binding Nombre}" />
                            <DataGridTextColumn Header="Inicio" Binding="{Binding Inicio, StringFormat={}{0:d}}" />
                            <DataGridTextColumn Header="Fin" Binding="{Binding Fin, StringFormat={}{0:d}}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Paquetes">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <TextBlock Text="Nombre" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtPaquete" Width="160" />
                        <TextBlock Text="Descripción" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtDescripcionPaquete" Width="220" />
                        <TextBlock Text="Precio" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtPrecioPaquete" Width="90" />
                        <Button Content="Guardar" Click="OnGuardarPaquete" />
                    </WrapPanel>
                    <DataGrid x:Name="GridPaquetes" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Paquete" Binding="{Binding Nombre}" />
                            <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" />
                            <DataGridTextColumn Header="Precio" Binding="{Binding Precio}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Promociones">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <TextBlock Text="Nombre" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtPromocion" Width="160" />
                        <TextBlock Text="Descuento (%)" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtDescuento" Width="80" />
                        <TextBlock Text="Inicio" VerticalAlignment="Center" />
                        <DatePicker x:Name="DpPromoInicio" />
                        <TextBlock Text="Fin" VerticalAlignment="Center" />
                        <DatePicker x:Name="DpPromoFin" />
                        <CheckBox x:Name="ChkPromoActiva" Content="Activa" VerticalAlignment="Center" IsChecked="True" />
                        <Button Content="Guardar" Click="OnGuardarPromocion" />
                    </WrapPanel>
                    <DataGrid x:Name="GridPromociones" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Promoción" Binding="{Binding Nombre}" />
                            <DataGridTextColumn Header="Descuento" Binding="{Binding Descuento}" />
                            <DataGridTextColumn Header="Inicio" Binding="{Binding Inicio, StringFormat={}{0:d}}" />
                            <DataGridTextColumn Header="Fin" Binding="{Binding Fin, StringFormat={}{0:d}}" />
                            <DataGridTextColumn Header="Estado" Binding="{Binding Activa}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Precios por canal">
                <DataGrid AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tarifa" />
                        <DataGridTextColumn Header="Temporada" />
                        <DataGridTextColumn Header="Canal" />
                        <DataGridTextColumn Header="Precio" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
