<UserControl x:Class="Crown__.Frontend.Views.Modules.TarifasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Tarifas y promociones" VerticalAlignment="Center" />
            <Button Content="Nueva tarifa" Click="OnNuevaTarifa" />
            <Button Content="Cambiar precio" Click="OnCambiarPrecio" />
            <Button Content="Nueva temporada" Click="OnNuevaTemporada" />
            <Button Content="Nuevo paquete" Click="OnNuevoPaquete" />
            <Button Content="Nueva promoción" Click="OnNuevaPromocion" />
        </StackPanel>

        <TextBlock x:Name="TxtAviso" Grid.Row="1" Margin="0,4,0,4" />

        <GroupBox Grid.Row="2" Header="Tarifas por tipo de habitación (la tarifa base se usa al reservar y al hacer el check-in)">
            <DataGrid x:Name="GridTarifas" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tipo de habitación" Binding="{Binding Tipo}" Width="*" />
                    <DataGridTextColumn Header="Tarifa" Binding="{Binding Nombre}" Width="*" />
                    <DataGridTextColumn Header="Precio base por noche" Binding="{Binding PrecioTexto}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <TabControl Grid.Row="3">
            <TabItem Header="Temporadas">
                <DataGrid x:Name="GridTemporadas" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Temporada" Binding="{Binding Nombre}" Width="*" />
                        <DataGridTextColumn Header="Inicio" Binding="{Binding InicioTexto}" Width="*" />
                        <DataGridTextColumn Header="Fin" Binding="{Binding FinTexto}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Paquetes">
                <DataGrid x:Name="GridPaquetes" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Paquete" Binding="{Binding Nombre}" Width="*" />
                        <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="2*" />
                        <DataGridTextColumn Header="Precio" Binding="{Binding PrecioTexto}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Promociones">
                <DataGrid x:Name="GridPromociones" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Promoción" Binding="{Binding Nombre}" Width="*" />
                        <DataGridTextColumn Header="Descuento" Binding="{Binding DescuentoTexto}" Width="*" />
                        <DataGridTextColumn Header="Inicio" Binding="{Binding InicioTexto}" Width="*" />
                        <DataGridTextColumn Header="Fin" Binding="{Binding FinTexto}" Width="*" />
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Precios por canal">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button Content="Nuevo precio por canal" Click="OnNuevoPrecioCanal" HorizontalAlignment="Left" />
                    <DataGrid x:Name="GridCanales" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tarifa" Binding="{Binding Tarifa}" Width="2*" />
                            <DataGridTextColumn Header="Temporada" Binding="{Binding Temporada}" Width="*" />
                            <DataGridTextColumn Header="Canal" Binding="{Binding Canal}" Width="*" />
                            <DataGridTextColumn Header="Precio" Binding="{Binding PrecioTexto}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
