<UserControl x:Class="Crown__.Frontend.Views.Modules.ConsumosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="200" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Consumos y servicios" VerticalAlignment="Center" />
            <TextBlock Text="Estancia" VerticalAlignment="Center" />
            <ComboBox x:Name="CmbEstancia" Width="220" DisplayMemberPath="Texto" SelectionChanged="OnEstancia" />
            <Button Content="Nuevo producto" Click="OnNuevoProducto" />
            <Button Content="Registrar consumo" Click="OnRegistrarConsumo" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Catálogo de productos">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Buscar…" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtBuscar" Width="140" TextChanged="OnBuscar" />
                    </StackPanel>
                    <ListBox x:Name="LstProductos" Grid.Row="1" DisplayMemberPath="Texto" SelectionChanged="OnProducto" />
                </Grid>
            </GroupBox>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <GroupBox Header="Consumo de la estancia">
                    <DataGrid x:Name="GridConsumos" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" />
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" />
                            <DataGridTextColumn Header="Precio" Binding="{Binding Precio}" />
                            <DataGridTextColumn Header="Total" Binding="{Binding Total}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
                <GroupBox Grid.Row="1" Header="Totales">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Subtotal" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtSubtotal" Grid.Column="1" IsReadOnly="True" />
                        <TextBlock Grid.Column="2" Text="Impuesto" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtImpuesto" Grid.Column="3" IsReadOnly="True" />
                        <TextBlock Grid.Column="4" Text="Total" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtTotal" Grid.Column="5" IsReadOnly="True" />
                        <Button Grid.Column="6" Content="Cobrar saldo" Click="OnCobrar" />
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>

        <TabControl Grid.Row="2">
            <TabItem Header="Servicios">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <TextBlock Text="Nombre" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtNombreServicio" Width="160" />
                        <TextBlock Text="Tipo" VerticalAlignment="Center" />
                        <ComboBox x:Name="CmbTipoServicio" Width="120" />
                        <TextBlock Text="Precio" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtPrecioServicio" Width="80" />
                        <CheckBox x:Name="ChkServicioActivo" Content="Activo" VerticalAlignment="Center" IsChecked="True" />
                        <Button Content="Guardar" Click="OnGuardarServicio" />
                    </WrapPanel>
                    <DataGrid x:Name="GridServicios" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Servicio" Binding="{Binding Nombre}" />
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" />
                            <DataGridTextColumn Header="Precio" Binding="{Binding Precio}" />
                            <DataGridTextColumn Header="Activo" Binding="{Binding Activo}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Citas">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Button Content="Programar cita" Click="OnProgramarCita" HorizontalAlignment="Left"/><DataGrid x:Name="GridCitas" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Reserva" Binding="{Binding Reserva}"/><DataGridTextColumn Header="Servicio" Binding="{Binding Servicio}"/><DataGridTextColumn Header="Fecha y hora" Binding="{Binding Fecha, StringFormat={}{0:g}}"/><DataGridTextColumn Header="Duración (min)" Binding="{Binding Duracion}"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}"/></DataGrid.Columns></DataGrid></Grid>
            </TabItem>

            <TabItem Header="Traslados">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Button Content="Programar traslado" Click="OnProgramarTraslado" HorizontalAlignment="Left"/><DataGrid x:Name="GridTraslados" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Reserva" Binding="{Binding Reserva}"/><DataGridTextColumn Header="Origen" Binding="{Binding Origen}"/><DataGridTextColumn Header="Destino" Binding="{Binding Destino}"/><DataGridTextColumn Header="Fecha y hora" Binding="{Binding Fecha, StringFormat={}{0:g}}"/></DataGrid.Columns></DataGrid></Grid>
            </TabItem>

            <TabItem Header="Movimientos de inventario">
                <DataGrid AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Producto" />
                        <DataGridTextColumn Header="Tipo" />
                        <DataGridTextColumn Header="Cantidad" />
                        <DataGridTextColumn Header="Motivo" />
                        <DataGridTextColumn Header="Fecha" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
