<UserControl x:Class="Crown__.Frontend.Views.Modules.ConsumosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="200" />
        </Grid.RowDefinitions>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal">
            <TextBlock Text="Consumos y servicios" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Text="Estancia" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Width="160" Margin="0,2,6,2" />
            <Button Content="Nuevo producto" />
            <Button Content="Registrar consumo" />
        </StackPanel></ScrollViewer>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Catálogo de productos">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal">
                        <TextBlock Text="Buscar…" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="140" Margin="0,2,6,2" />
                    </StackPanel></ScrollViewer>
                    <ListBox Grid.Row="1">
                        <ListBoxItem Content="Producto · Precio" />
                        <ListBoxItem Content="Producto · Precio" />
                        <ListBoxItem Content="Producto · Precio" />
                        <ListBoxItem Content="Producto · Precio" />
                        <ListBoxItem Content="Producto · Precio" />
                    </ListBox>
                </Grid>
            </GroupBox>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <GroupBox Header="Consumo de la estancia">
                    <DataGrid AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Producto" />
                            <DataGridTextColumn Header="Cantidad" />
                            <DataGridTextColumn Header="Precio" />
                            <DataGridTextColumn Header="Total" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
                <GroupBox Grid.Row="1" Header="Totales">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Subtotal" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Column="1" IsReadOnly="True" Margin="0,2,6,2" />
                        <TextBlock Grid.Column="2" Text="Impuesto" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Column="3" IsReadOnly="True" Margin="0,2,6,2" />
                        <TextBlock Grid.Column="4" Text="Total" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Column="5" IsReadOnly="True" Margin="0,2,6,2" />
                        <Button Grid.Column="6" Content="Cobrar" />
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>

        <TabControl Grid.Row="2">
            <TabItem Header="Servicios">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <TextBlock Text="Nombre" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="160" Margin="0,2,6,2" />
                        <TextBlock Text="Tipo" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Width="120" Margin="0,2,6,2" />
                        <TextBlock Text="Precio" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="80" Margin="0,2,6,2" />
                        <CheckBox Content="Activo" VerticalAlignment="Center" />
                        <Button Content="Guardar" />
                    </WrapPanel>
                    <DataGrid Grid.Row="1" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Servicio" />
                            <DataGridTextColumn Header="Tipo" />
                            <DataGridTextColumn Header="Precio" />
                            <DataGridTextColumn Header="Activo" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Citas">
                <DataGrid AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Reserva de servicio" />
                        <DataGridTextColumn Header="Fecha y hora" />
                        <DataGridTextColumn Header="Duración" />
                        <DataGridTextColumn Header="Estado" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Traslados">
                <DataGrid AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Reserva de servicio" />
                        <DataGridTextColumn Header="Origen" />
                        <DataGridTextColumn Header="Destino" />
                        <DataGridTextColumn Header="Fecha y hora" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Movimientos de inventario">
                <DataGrid AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Producto" />
                        <DataGridTextColumn Header="Tipo" />
                        <DataGridTextColumn Header="Cantidad" />
                        <DataGridTextColumn Header="Motivo" />
                        <DataGridTextColumn Header="Fecha" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
