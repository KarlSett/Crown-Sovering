<UserControl x:Class="Crown__.Frontend.Views.Sections.HabitacionesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="620"
             FontFamily="{StaticResource HotelSansFont}"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display" Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Entrada" Style="{StaticResource EyebrowText}" Margin="2,0,0,5" />
                <DatePicker x:Name="DpInicio" Width="140" Height="40" FontSize="13" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock Text="Salida" Style="{StaticResource EyebrowText}" Margin="2,0,0,5" />
                <DatePicker x:Name="DpFin" Width="140" Height="40" FontSize="13" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                <TextBlock Text="Tipo" Style="{StaticResource EyebrowText}" Margin="2,0,0,5" />
                <ComboBox x:Name="CmbCapacidad" Width="132" Height="40" FontSize="13" />
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="10,0,0,0">
                <TextBlock Text="Calidad" Style="{StaticResource EyebrowText}" Margin="2,0,0,5" />
                <ComboBox x:Name="CmbCalidadHabitacion" Width="140" Height="40" FontSize="13" />
            </StackPanel>
            <Button Grid.Column="5" Content="Buscar disponibilidad" Style="{StaticResource PrimaryButton}"
                    VerticalAlignment="Bottom" Click="OnBuscarDisponibilidad" />
        </Grid>
        </ScrollViewer>

        <TextBlock x:Name="TxtResumenHabitaciones" Grid.Row="1" Style="{StaticResource MutedText}"
                   Margin="2,14,10,0" FontSize="12.5" />

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,10,0" Padding="0">
            <Grid>
            <DataGrid x:Name="GridHabitaciones" Style="{StaticResource HotelDataGrid}" Margin="4"
                      CanUserSortColumns="False" RowDetailsVisibilityMode="VisibleWhenSelected">
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource UI.Selection}" Padding="16,12" Margin="0,0,0,4">
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource UI.Text}" FontWeight="SemiBold"><Run Text="Habitación " /><Run Text="{Binding Numero}" /><Run Text=" · " /><Run Text="{Binding Tipo}" /><Run Text=" · " /><Run Text="{Binding Calidad}" /></TextBlock>
                                <TextBlock Foreground="{DynamicResource UI.Muted}" Margin="0,5,0,0"><Run Text="{Binding Tarifa}" /><Run Text=" por noche · " /><Run Text="{Binding Capacidad}" /><Run Text=" · " /><Run Text="{Binding Extras}" /></TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Hab." Width="64" MinWidth="64"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Numero}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="Piso" Binding="{Binding Piso}" Width="52" MinWidth="52" />
                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="84" MinWidth="84" />
                    <DataGridTextColumn Header="Calidad" Binding="{Binding Calidad}" Width="112" MinWidth="112" />
                    <DataGridTextColumn Header="Capacidad" Binding="{Binding Capacidad}" Width="82" MinWidth="82" />
                    <DataGridTextColumn Header="Tarifa" Binding="{Binding Tarifa}" Width="94" MinWidth="94" />
                    <DataGridTextColumn Header="Atributos" Binding="{Binding Extras}" Width="*" />
                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="112" MinWidth="112" />
                    <DataGridTemplateColumn Header="Disponibilidad" Width="154" MinWidth="154"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource AvailabilityBadge}" Margin="6,0" VerticalAlignment="Center"><TextBlock Text="{Binding Disponibilidad}" Style="{StaticResource AvailabilityText}" /></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
                <TextBlock Text="No hay habitaciones con estos filtros. Prueba otro tipo o calidad." Foreground="{DynamicResource UI.Muted}"
                           TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=GridHabitaciones}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
