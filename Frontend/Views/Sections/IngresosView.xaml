<UserControl x:Class="Crown__.Frontend.Views.Sections.IngresosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Crown__.Frontend.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="620"
             FontFamily="{StaticResource HotelSansFont}"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display" Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Selector de período -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Background="#0F17384F" CornerRadius="12" Padding="4">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RbDiario" GroupName="Periodo" IsChecked="True" Content="Diario"
                                 Tag="Diario" Checked="OnPeriodoChanged" Style="{StaticResource PeriodOption}" />
                    <RadioButton x:Name="RbSemanal" GroupName="Periodo" Content="Semanal"
                                 Tag="Semanal" Checked="OnPeriodoChanged" Style="{StaticResource PeriodOption}" />
                    <RadioButton x:Name="RbTrimestral" GroupName="Periodo" Content="Trimestral"
                                 Tag="Trimestral" Checked="OnPeriodoChanged" Style="{StaticResource PeriodOption}" />
                </StackPanel>
            </Border>

            <TextBlock Grid.Column="1" x:Name="TxtPeriodo" Style="{StaticResource StrongText}"
                       VerticalAlignment="Center" Margin="16,0,0,0" FontSize="13" />

            <Button Grid.Column="2" Content="◀" Style="{StaticResource GhostButton}" Width="40"
                    Click="OnPeriodoAnterior" ToolTip="Período anterior" />
            <Button Grid.Column="3" Content="Hoy" Style="{StaticResource GhostButton}" Width="52"
                    Click="OnPeriodoHoy" ToolTip="Volver al período actual" />
            <Button Grid.Column="4" Content="▶" Style="{StaticResource GhostButton}" Width="40"
                    Click="OnPeriodoSiguiente" ToolTip="Período siguiente" />
        </Grid>

        <!-- Totales del período -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,12,0,0">
            <controls:KpiCard x:Name="KpiCobrado" Titulo="COBRADO" Valor="—" TamanoValor="22"
                              Pista="abonos del período" Margin="0,0,10,0" />
            <controls:KpiCard x:Name="KpiFacturado" Titulo="FACTURADO" Valor="—" TamanoValor="22"
                              Pista="cargos del período" Margin="0,0,10,0" />
            <controls:KpiCard x:Name="KpiPorCobrar" Titulo="POR COBRAR" Valor="—" TamanoValor="22"
                              Pista="diferencia cargos − abonos" Margin="0,0,10,0" />
            <controls:KpiCard x:Name="KpiMovimientos" Titulo="MOVIMIENTOS" Valor="—" TamanoValor="22"
                              Pista="transacciones registradas" Margin="0,0,10,0" />
        </UniformGrid>

        <ScrollViewer Grid.Row="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:SectionCard Titulo="Cuentas de ingreso" Nota="Cobrado por cuenta">
                            <ItemsControl x:Name="ListaCuentas">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Cuenta}" Style="{StaticResource StrongText}"
                                                           FontSize="12.5" />
                                                <TextBlock Grid.Column="1" Text="{Binding AbonosTexto}"
                                                           Style="{StaticResource StrongText}" FontWeight="SemiBold" />
                                            </Grid>
                                            <Border Style="{StaticResource BarTrack}" Margin="0,7,0,0">
                                                <Border Style="{StaticResource BarFill}" Width="{Binding AnchoBarra}" />
                                            </Border>
                                            <TextBlock Text="{Binding ParticipacionTexto}" Style="{StaticResource MutedText}"
                                                       FontSize="10.5" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                    </controls:SectionCard>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <controls:SectionCard Titulo="Medios de pago">
                                <ItemsControl x:Name="ListaMedios">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8" Fill="{Binding Color}"
                                                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding Nombre}" Style="{StaticResource MutedText}"
                                                                   FontSize="12" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Monto}"
                                                               Style="{StaticResource StrongText}" FontWeight="SemiBold" />
                                                </Grid>
                                                <Border Style="{StaticResource BarTrack}" Margin="0,6,0,0">
                                                    <Border Style="{StaticResource BarFill}" Width="{Binding AnchoBarra}"
                                                            Background="{Binding Color}" />
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                        </controls:SectionCard>

                        <controls:SectionCard Grid.Row="1" Titulo="Resumen del período" Margin="0,12,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Promedio por día" Style="{StaticResource MutedText}" />
                                        <TextBlock x:Name="TxtResumenPromedio" Grid.Column="1"
                                                   Style="{StaticResource StrongText}" />
                                    </Grid>
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Mejor cuenta" Style="{StaticResource MutedText}" />
                                        <TextBlock x:Name="TxtResumenMejor" Grid.Column="1"
                                                   Style="{StaticResource StrongText}" />
                                    </Grid>
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Total por medios" Style="{StaticResource MutedText}" />
                                        <TextBlock x:Name="TxtResumenMedios" Grid.Column="1"
                                                   Style="{StaticResource StrongText}" />
                                    </Grid>
                                </StackPanel>
                        </controls:SectionCard>
                    </Grid>
                </Grid>

                <controls:SectionCard x:Name="CardDetalle" Titulo="Movimientos del día" Margin="0,12,10,10">
                        <DataGrid x:Name="GridDetalle" Style="{StaticResource HotelDataGrid}"
                                  Height="230" CanUserSortColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hora · cuenta" Binding="{Binding Etiqueta}" Width="*" />
                                <DataGridTextColumn Header="Cargos" Binding="{Binding Cargos}" Width="120" />
                                <DataGridTextColumn Header="Abonos" Binding="{Binding Abonos}" Width="120" />
                                <DataGridTextColumn Header="Saldo" Binding="{Binding Saldo}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                </controls:SectionCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
