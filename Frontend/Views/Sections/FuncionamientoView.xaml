<UserControl x:Class="Crown__.Frontend.Views.Sections.FuncionamientoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Crown__.Frontend.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="620"
             FontFamily="{StaticResource HotelSansFont}"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <UniformGrid Columns="4">
                <controls:KpiCard x:Name="KpiOcupacion" Titulo="OCUPACIÓN" Valor="—"
                                  Pista="de 24 habitaciones" Margin="0,0,10,10" />
                <controls:KpiCard x:Name="KpiDisponibles" Titulo="DISPONIBLES HOY" Valor="—"
                                  Pista="listas para vender" Margin="0,0,10,10" />
                <controls:KpiCard x:Name="KpiLlegadas" Titulo="LLEGADAS DE HOY" Valor="—"
                                  Pista="check-ins previstos" Margin="0,0,10,10" />
                <controls:KpiCard x:Name="KpiSalidas" Titulo="SALIDAS DE HOY" Valor="—"
                                  Pista="check-outs previstos" Margin="0,0,10,10" />
            </UniformGrid>

            <UniformGrid Columns="4" Margin="0,2,0,4">
                <controls:KpiCard x:Name="KpiEnCasa" Titulo="EN CASA" Valor="—"
                                  Pista="estancias en curso" Margin="0,0,10,10" />
                <controls:KpiCard x:Name="KpiIngresos" Titulo="INGRESOS DE HOY" Valor="—"
                                  Pista="cobros registrados" Margin="0,0,10,10" />
                <controls:KpiCard x:Name="KpiSaldo" Titulo="SALDO PENDIENTE" Valor="—"
                                  Pista="en folios abiertos" Margin="0,0,10,10" />
                <controls:KpiCard x:Name="KpiActivas" Titulo="RESERVAS ACTIVAS" Valor="—"
                                  Pista="confirmadas y en curso" Margin="0,0,10,10" />
            </UniformGrid>

            <controls:SectionCard x:Name="CardEstados" Titulo="Estado de habitaciones" Margin="0,4,10,0">
                    <ItemsControl x:Name="ListaEstados">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:StatusBadge Etiqueta="{Binding Nombre}" Cantidad="{Binding Cantidad}"
                                                      Color="{Binding Color}" Margin="0,0,8,8" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
            </controls:SectionCard>

            <Grid Margin="0,14,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:SectionCard Titulo="Llegadas de hoy">
                        <ItemsControl x:Name="ListaLlegadas">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Huesped}" Style="{StaticResource StrongText}" />
                                            <TextBlock Text="{Binding Detalle}" Style="{StaticResource MutedText}"
                                                       Margin="0,3,0,0" FontSize="11.5" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource EstadoPill}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Hora}" Style="{StaticResource MutedText}" FontSize="11" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                </controls:SectionCard>

                <controls:SectionCard Grid.Column="2" Titulo="Salidas de hoy">
                        <ItemsControl x:Name="ListaSalidas">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Huesped}" Style="{StaticResource StrongText}" />
                                            <TextBlock Text="{Binding Detalle}" Style="{StaticResource MutedText}"
                                                       Margin="0,3,0,0" FontSize="11.5" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource EstadoPill}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Hora}" Style="{StaticResource MutedText}" FontSize="11" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                </controls:SectionCard>
            </Grid>

            <controls:SectionCard Titulo="Movimientos recientes" Margin="0,14,10,10">
                    <DataGrid x:Name="GridMovimientos" Style="{StaticResource HotelDataGrid}"
                              Height="230" CanUserSortColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Hora" Binding="{Binding Hora}" Width="70" />
                            <DataGridTextColumn Header="Cuenta" Binding="{Binding Concepto}" Width="120" />
                            <DataGridTextColumn Header="Huésped" Binding="{Binding Huesped}" Width="*" />
                            <DataGridTextColumn Header="Medio" Binding="{Binding MetodoPago}" Width="110" />
                            <DataGridTextColumn Header="Monto" Binding="{Binding Monto}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
            </controls:SectionCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
