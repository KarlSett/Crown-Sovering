<Page x:Class="Crown__.Frontend.Views.LoginView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d" d:DesignWidth="1172" d:DesignHeight="702"
      Title="Crown &amp; Sovereign — Inicio de sesión"
      FontFamily="{StaticResource HotelSansFont}"
      UseLayoutRounding="True" SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display" Loaded="OnLoaded" Unloaded="OnUnloaded">
    <Page.Style>
        <Style TargetType="Page">
            <Setter Property="Tag" Value="Light" />
            <Setter Property="Background" Value="{StaticResource Light.Page}" />
            <Setter Property="Foreground" Value="{StaticResource Light.Ink}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=ThemeToggle}" Value="True">
                    <Setter Property="Tag" Value="Dark" />
                    <Setter Property="Background" Value="{StaticResource Dark.Page}" />
                    <Setter Property="Foreground" Value="{StaticResource Dark.Ink}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Style>
    <!-- Frontend only: no credentials are validated, saved, or sent. -->
    <Grid Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Page}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.52*" />
            <ColumnDefinition Width="0.48*" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="HospitalityPanel" SizeChanged="UpdatePanelClip" Background="{StaticResource Brand.Navy}">
            <Image x:Name="LobbyPoster" Source="../Assets/hospitality-lobby.png" Stretch="UniformToFill"
                   RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False"
                   AutomationProperties.Name="Interior de un hotel, luz cálida y un jardín al atardecer">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="PosterScale" ScaleX="1" ScaleY="1" />
                </Image.RenderTransform>
            </Image>
            <!-- An optional local MP4 replaces the poster. No media is fetched online. -->
            <MediaElement x:Name="HospitalityVideo" LoadedBehavior="Manual" UnloadedBehavior="Close"
                          Stretch="UniformToFill" IsMuted="True" Volume="0" Opacity="0"
                          MediaOpened="OnVideoOpened" MediaEnded="OnVideoEnded" MediaFailed="OnVideoFailed"
                          IsHitTestVisible="False" Focusable="False" />
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#670B1922" Offset="0" />
                        <GradientStop Color="#050B1922" Offset="0.38" />
                        <GradientStop Color="#800B1922" Offset="0.66" />
                        <GradientStop Color="#E80B1922" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Grid Margin="36,32,36,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                    <ContentControl Width="52" Height="52" Margin="0,0,14,0" Focusable="False" IsTabStop="False"
                                    AutomationProperties.Name="Emblema de Crown &amp; Sovereign"
                                    Template="{StaticResource CrownSovereignLogoTemplate}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Crown &amp; Sovereign" FontFamily="{StaticResource HotelSerifFont}"
                                   FontSize="22" Foreground="{StaticResource Brand.Ivory}" />
                        <TextBlock Text="Hotel" FontSize="12" Margin="0,4,0,0" Foreground="{StaticResource Brand.Gold}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="0,24,0,36">
                    <TextBlock FontFamily="{StaticResource HotelSerifFont}" FontSize="44" LineHeight="53"
                               TextWrapping="Wrap" Foreground="{StaticResource Brand.Ivory}">
                        <Run Text="Hospitalidad" /><LineBreak /><Run Text="con distinción." />
                    </TextBlock>
                    <TextBlock Text="El cuidado empieza en cada detalle." FontSize="14"
                               Margin="0,18,0,0" TextWrapping="Wrap" Foreground="#E2E6E4" />
                </StackPanel>
                <Grid Grid.Row="3">
                    <TextBlock Text="Crown &amp; Sovereign Hotel" FontSize="11" Foreground="#D2DAD8"
                               VerticalAlignment="Center" Margin="0,0,48,0" />
                    <ToggleButton x:Name="MotionToggle" HorizontalAlignment="Right"
                                  Style="{StaticResource HotelMotionToggle}" IsChecked="False"
                                  Click="OnMotionToggle" ToolTip="Pausar o reanudar el fondo"
                                  AutomationProperties.Name="Pausar animación de fondo" KeyboardNavigation.TabIndex="7" />
                </Grid>
            </Grid>
        </Grid>
        <Grid Grid.Column="1" Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
                <RowDefinition Height="48" />
            </Grid.RowDefinitions>
            <ToggleButton x:Name="ThemeToggle" IsChecked="False" Margin="0,0,20,0"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource HotelThemeToggle}" AutomationProperties.Name="Tema oscuro"
                          ToolTip="Cambiar entre apariencia clara y oscura" KeyboardNavigation.TabIndex="6" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False" Padding="0,8,0,12">
                <Grid Margin="36,0" MaxWidth="344" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Bienvenido de nuevo" FontSize="29" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,0,0,10" />
                        <TextBlock Text="Ingresa a tu espacio de trabajo." Style="{StaticResource HotelSecondaryText}"
                                   TextWrapping="Wrap" Margin="0,0,0,34" />
                        <Label Content="_Usuario" Target="{Binding ElementName=TxtUsuario}"
                               Style="{StaticResource HotelFieldLabel}" />
                        <TextBox x:Name="TxtUsuario" Tag="Tu usuario" Style="{StaticResource HotelTextBox}"
                                 Margin="0,0,0,20" AutomationProperties.Name="Usuario" KeyboardNavigation.TabIndex="0" />
                        <Label Content="_Contraseña" Target="{Binding ElementName=TxtContrasena}"
                               Style="{StaticResource HotelFieldLabel}" />
                        <PasswordBox x:Name="TxtContrasena" PasswordChar="●" Style="{StaticResource HotelPasswordBox}"
                                     AutomationProperties.Name="Contraseña" KeyboardNavigation.TabIndex="1" />
                        <Grid Margin="0,18,0,28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkRecordarme" Content="Recordarme" Style="{StaticResource HotelCheckBox}"
                                      VerticalAlignment="Center" KeyboardNavigation.TabIndex="2" />
                            <Button x:Name="BtnSoporteTecnico" Grid.Column="1" Content="Soporte técnico"
                                    Style="{StaticResource HotelLinkButton}" KeyboardNavigation.TabIndex="3" />
                        </Grid>
                        <Button x:Name="BtnIngresar" IsDefault="True" Style="{StaticResource HotelPrimaryButton}"
                                KeyboardNavigation.TabIndex="4" AutomationProperties.Name="Ingresar">
                            <Grid>
                                <TextBlock Text="Ingresar" HorizontalAlignment="Center" />
                                <Path Data="M1,6 H13 M8,1 L13,6 L8,11" Width="14" Height="12"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button x:Name="BtnLoginSimulado" Content="Inicio de sesión simulado"
                                Style="{StaticResource HotelSecondaryButton}" Margin="0,12,0,0"
                                KeyboardNavigation.TabIndex="5" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <TextBlock Grid.Row="2" Text="Sistema de gestión hotelera" FontSize="11"
                       Style="{StaticResource HotelSecondaryText}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Margin="20,0" />
        </Grid>
    </Grid>
</Page>