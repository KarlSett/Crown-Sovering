<Page x:Class="Crown__.Frontend.Views.DashboardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:sections="clr-namespace:Crown__.Frontend.Views.Sections"
      xmlns:modules="clr-namespace:Crown__.Frontend.Views.Modules"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d" d:DesignWidth="1172" d:DesignHeight="702"
      Title="Crown &amp; Sovereign — Panel de gestión"
      FontFamily="{StaticResource HotelSansFont}"
      UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
      Loaded="OnLoaded">
    <Page.Style>
        <Style TargetType="Page">
            <Setter Property="Tag" Value="{DynamicResource UI.Mode}" />
            <Setter Property="Background" Value="{DynamicResource UI.Page}" />
            <Setter Property="Foreground" Value="{DynamicResource UI.Text}" />
        </Style>
    </Page.Style>

    <Grid Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Page}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================ Barra lateral ============================ -->
        <Border Grid.Column="0" Background="{DynamicResource UI.Sidebar}" CornerRadius="16" BorderBrush="{DynamicResource UI.SidebarBorder}" BorderThickness="1">
            <Grid Margin="18,24,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <ContentControl Width="42" Height="42" Margin="0,0,10,0" Focusable="False" IsTabStop="False"
                                    AutomationProperties.Name="Emblema de Crown &amp; Sovereign"
                                    Template="{StaticResource CrownSovereignLogoTemplate}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Crown &amp; Sovereign" FontFamily="{StaticResource HotelSansFont}" FontWeight="SemiBold"
                                   FontSize="13" Foreground="{DynamicResource UI.SidebarText}" />
                        <TextBlock Text="Gestión hotelera" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource UI.BrandMark}" />
                    </StackPanel>
                </StackPanel>

                <!-- Navegación agrupada. La visibilidad por rol es solo de presentación. -->
                <ScrollViewer Grid.Row="1" Margin="0,20,0,12" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>
                        <TextBlock Text="Operación" Style="{StaticResource EyebrowText}"
                                   Foreground="{DynamicResource UI.SidebarMuted}" Margin="12,0,0,8" />
                        <RadioButton x:Name="NavFuncionamiento" Style="{StaticResource NavItem}" GroupName="Navegacion"
                                     Content="Funcionamiento" Tag="funcionamiento" IsChecked="True" Checked="OnNavChecked" />
                        <RadioButton x:Name="NavReservas" Style="{StaticResource NavItem}" GroupName="Navegacion"
                                     Content="Reservas" Tag="reservas" Checked="OnNavChecked" />
                        <RadioButton x:Name="NavHabitaciones" Style="{StaticResource NavItem}" GroupName="Navegacion"
                                     Content="Habitaciones disponibles" Tag="habitaciones" Checked="OnNavChecked" />
                        <RadioButton x:Name="NavIngresos" Style="{StaticResource NavItem}" GroupName="Navegacion"
                                     Content="Cuentas de ingreso" Tag="ingresos" Checked="OnNavChecked" />

                        <StackPanel x:Name="GrupoAdministracion">
                            <TextBlock Text="Administración" Style="{StaticResource EyebrowText}"
                                       Foreground="{DynamicResource UI.SidebarMuted}" Margin="12,18,0,8" />
                            <RadioButton x:Name="NavHuespedes" Style="{StaticResource NavItem}" GroupName="Navegacion"
                                         Content="Huéspedes" Tag="huespedes" Checked="OnNavChecked" />
                            <RadioButton x:Name="NavInventario" Style="{StaticResource NavItem}" GroupName="Navegacion"
                                         Content="Inventario" Tag="inventario" Checked="OnNavChecked" />
                            <RadioButton x:Name="NavEstancias" Style="{StaticResource NavItem}" GroupName="Navegacion"
                                         Content="Estancias y llaves" Tag="estancias" Checked="OnNavChecked" />
                            <RadioButton x:Name="NavFacturacion" Style="{StaticResource NavItem}" GroupName="Navegacion"
                                         Content="Facturación" Tag="facturacion" Checked="OnNavChecked" />
                            <RadioButton x:Name="NavPagos" Style="{StaticResource NavItem}" GroupName="Navegacion"
                                         Content="Pagos y caja" Tag="pagos" Checked="OnNavChecked" />
                            <RadioButton x:Name="NavReservasAdmin" Style="{StaticResource NavItem}" GroupName="Navegacion"
                                         Content="Reservas avanzadas" Tag="reservasadmin" Checked="OnNavChecked" />
                            <RadioButton x:Name="NavNotificaciones" Style="{StaticResource NavItem}" GroupName="Navegacion"
                                         Content="Notificaciones" Tag="notificaciones" Checked="OnNavChecked" />
                        </StackPanel>

                        <StackPanel x:Name="GrupoProducto">
                            <TextBlock Text="Producto" Style="{StaticResource EyebrowText}"
                                       Foreground="{DynamicResource UI.SidebarMuted}" Margin="12,18,0,8" />
                            <RadioButton x:Name="NavTarifas" Style="{StaticResource NavItem}" GroupName="Navegacion"
                                         Content="Tarifas" Tag="tarifas" Checked="OnNavChecked" />
                            <RadioButton x:Name="NavConvenios" Style="{StaticResource NavItem}" GroupName="Navegacion"
                                         Content="Convenios" Tag="convenios" Checked="OnNavChecked" />
                        </StackPanel>

                        <StackPanel x:Name="GrupoServicios">
                            <TextBlock Text="Servicios" Style="{StaticResource EyebrowText}"
                                       Foreground="{DynamicResource UI.SidebarMuted}" Margin="12,18,0,8" />
                            <RadioButton x:Name="NavLimpieza" Style="{StaticResource NavItem}" GroupName="Navegacion"
                                         Content="Limpieza y mantenimiento" Tag="limpieza" Checked="OnNavChecked" />
                            <RadioButton x:Name="NavConsumos" Style="{StaticResource NavItem}" GroupName="Navegacion"
                                         Content="Consumos y servicios" Tag="consumos" Checked="OnNavChecked" />
                        </StackPanel>

                        <StackPanel x:Name="GrupoConfiguracion">
                            <TextBlock Text="Configuración" Style="{StaticResource EyebrowText}"
                                       Foreground="{DynamicResource UI.SidebarMuted}" Margin="12,18,0,8" />
                            <RadioButton x:Name="NavConfiguracion" Style="{StaticResource NavItem}" GroupName="Navegacion"
                                         Content="Configuración del hotel" Tag="configuracion" Checked="OnNavChecked" />
                            <RadioButton x:Name="NavSeguridad" Style="{StaticResource NavItem}" GroupName="Navegacion"
                                         Content="Seguridad y personal" Tag="seguridad" Checked="OnNavChecked" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2">
                    <Border Background="{DynamicResource UI.SidebarHover}" CornerRadius="10" Padding="10,12" Margin="0,0,0,10">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource UI.SidebarActive}" CornerRadius="8" Width="28" Height="32" VerticalAlignment="Center"><Path Data="M13,6 A3,3 0 1 1 7,6 A3,3 0 1 1 13,6 M4,18 V15 Q4,11 10,11 Q16,11 16,15 V18" Stroke="{DynamicResource UI.OnSidebarActive}" StrokeThickness="1.4" Width="16" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" /></Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Sesión activa" FontSize="10" Foreground="{DynamicResource UI.SidebarMuted}" />
                                <TextBlock x:Name="TxtSesionUsuario" Text="Recepcionista" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource UI.SidebarText}" Margin="0,3,0,0" />
                                <TextBlock x:Name="TxtSesionDetalle" Text="Datos de demostración" FontSize="9.5" Foreground="{DynamicResource UI.SidebarMuted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Button Style="{StaticResource NavActionButton}" Click="OnCerrarSesion" AutomationProperties.Name="Cerrar sesión">
                        <StackPanel Orientation="Horizontal"><Path Data="M8,1 H2 V15 H8 M6,8 H16 M12,4 L16,8 12,12" Stroke="{DynamicResource UI.SidebarText}" StrokeThickness="1.5" Width="17" Height="16" Margin="0,0,10,0" /><TextBlock Text="Cerrar sesión" /></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ Contenido ============================ -->
        <Grid Grid.Column="1" Margin="24,18,18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TxtTitulo" Text="Funcionamiento" FontFamily="{StaticResource HotelSansFont}"
                               FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Page}}" />
                    <TextBlock x:Name="TxtSubtitulo" Style="{StaticResource MutedText}" FontSize="12.5" Margin="0,5,0,0"
                               Text="Ocupación, llegadas, salidas y movimientos del día." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <TextBlock x:Name="TxtFecha" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                               Margin="0,0,14,0" FontSize="12" />
                    <Button x:Name="ThemeToggle" Style="{StaticResource HotelThemeToggle}"
                                  AutomationProperties.Name="Cambiar apariencia"
                                  ToolTip="Cambiar apariencia: claro, oscuro y de marca" />
                </StackPanel>
            </Grid>

            <!-- Cada entrada de la barra lateral tiene su propia vista. -->
            <Grid x:Name="ViewHost" Grid.Row="1" Margin="0,16,0,0">
                <sections:FuncionamientoView x:Name="VistaFuncionamiento" Visibility="Collapsed" />
                <sections:ReservasView x:Name="VistaReservas" Visibility="Collapsed" />
                <sections:HabitacionesView x:Name="VistaHabitaciones" Visibility="Collapsed" />
                <sections:IngresosView x:Name="VistaIngresos" Visibility="Collapsed" />
                <modules:HuespedesView x:Name="VistaHuespedes" Visibility="Collapsed" />
                <modules:HabitacionesGestionView x:Name="VistaInventario" Visibility="Collapsed" />
                <modules:EstanciasView x:Name="VistaEstancias" Visibility="Collapsed" />
                <modules:FacturacionFoliosView x:Name="VistaFacturacion" Visibility="Collapsed" />
                <modules:PagosCajaView x:Name="VistaPagos" Visibility="Collapsed" />
                <modules:ReservasGestionView x:Name="VistaReservasAdmin" Visibility="Collapsed" />
                <modules:NotificacionesReportesView x:Name="VistaNotificaciones" Visibility="Collapsed" />
                <modules:TarifasView x:Name="VistaTarifas" Visibility="Collapsed" />
                <modules:ConveniosView x:Name="VistaConvenios" Visibility="Collapsed" />
                <modules:LimpiezaView x:Name="VistaLimpieza" Visibility="Collapsed" />
                <modules:ConsumosView x:Name="VistaConsumos" Visibility="Collapsed" />
                <modules:ConfiguracionHotelView x:Name="VistaConfiguracion" Visibility="Collapsed" />
                <modules:SeguridadView x:Name="VistaSeguridad" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</Page>
