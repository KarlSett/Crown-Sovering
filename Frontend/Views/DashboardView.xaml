<Page x:Class="Crown__.Frontend.Views.DashboardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d" d:DesignWidth="1172" d:DesignHeight="702"
      Title="Crown &amp; Sovereign — Panel principal"
      FontFamily="{StaticResource HotelSansFont}"
      UseLayoutRounding="True" SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display">
    <!-- Frontend only. No backend calls; data shown is illustrative. -->
    <Page.Style>
        <Style TargetType="Page">
            <Setter Property="Tag" Value="Light" />
            <Setter Property="Background" Value="{StaticResource Light.Page}" />
            <Setter Property="Foreground" Value="{StaticResource Light.Ink}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Dark">
                    <Setter Property="Background" Value="{StaticResource Dark.Page}" />
                    <Setter Property="Foreground" Value="{StaticResource Dark.Ink}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Brand">
                    <Setter Property="Background" Value="{StaticResource ThemeBrand.Page}" />
                    <Setter Property="Foreground" Value="{StaticResource ThemeBrand.Ink}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Style>
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- Iconos de módulo (viewport 24x24, tipo trazo) -->
        <Geometry x:Key="IconHome">M3,11 L12,4 L21,11 L21,20 L15,20 L15,14 L9,14 L9,20 L3,20 Z</Geometry>
        <Geometry x:Key="IconReservas">M4,5 H20 V20 H4 Z M4,9 H20 M8,3 V6 M16,3 V6 M8,14 H10 M14,14 H16 M8,17 H10 M14,17 H16</Geometry>
        <Geometry x:Key="IconHabitaciones">M3,15 V8 H21 V15 M3,15 V19 M21,15 V19 M3,12 H21 M8,12 V15 M16,12 V15</Geometry>
        <Geometry x:Key="IconCheckInOut">M4,3 H13 V21 H4 Z M13,12 H22 M18,9 L22,12 L18,15</Geometry>
        <Geometry x:Key="IconHuespedes">M12,7 A3,3 0 1 0 12,13 A3,3 0 1 0 12,7 M6,20 C6,16 9,15 12,15 C15,15 18,16 18,20</Geometry>
        <Geometry x:Key="IconConvenios">M3,8 H21 V20 H3 Z M8,8 V6 H16 V8 M3,13 H21 M11,13 H13 V15 H11 Z</Geometry>
        <Geometry x:Key="IconFNB">M7,3 L7,12 M9,3 L9,12 M8,3 L8,12 M16,3 C14,5 14,12 16,12 L16,20</Geometry>
        <Geometry x:Key="IconGymSpa">M12,3 C12,3 6,10 6,14 A6,6 0 0 0 18,14 C18,10 12,3 12,3 Z</Geometry>
        <Geometry x:Key="IconLavanderia">M8,4 L9,6 H15 L16,4 L20,7 L17,9 V20 H7 V9 L4,7 Z</Geometry>
        <Geometry x:Key="IconFinanzas">M3,17 L9,11 L13,15 L21,6 M16,6 L21,6 L21,11</Geometry>
        <Geometry x:Key="IconReportes">M6,3 H14 L19,8 V21 H6 Z M14,3 V8 H19 M9,13 H16 M9,17 H16 M9,9 H13</Geometry>
        <Geometry x:Key="IconAvisos">M12,3 A6,6 0 0 1 18,9 V14 L20,17 H4 L6,14 V9 A6,6 0 0 1 12,3 M10,19 A2,2 0 0 0 14,19</Geometry>
        <Geometry x:Key="IconConfig">M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 M12,3 V5 M12,19 V21 M3,12 H5 M19,12 H21 M5.6,5.6 L7,7 M17,17 L18.4,18.4 M5.6,18.4 L7,17 M17,7 L18.4,5.6</Geometry>
        <Geometry x:Key="IconBell">M12,3 A6,6 0 0 1 18,9 V14 L20,17 H4 L6,14 V9 A6,6 0 0 1 12,3 M10,19 A2,2 0 0 0 14,19</Geometry>

        <!-- Botón de módulo de la barra de navegación -->
        <Style x:Key="ModuleNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="2,5" />
            <Setter Property="FontFamily" Value="{StaticResource HotelSansFont}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="AutomationProperties.AutomationId" Value="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9" />
                            <Border x:Name="ActiveMark" Margin="4,0,4,3" VerticalAlignment="Bottom" Height="2.5"
                                    CornerRadius="2" Background="{StaticResource Brand.Gold}" Visibility="Collapsed" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#1417384F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#2617384F" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Dark">
                                <Setter TargetName="Surface" Property="Background" Value="Transparent" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Dark" />
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Surface" Property="Background" Value="#1CF6F3ED" />
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Brand">
                                <Setter TargetName="Surface" Property="Background" Value="Transparent" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Brand" />
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Surface" Property="Background" Value="#1CFFFFFF" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Brand" />
                                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Surface" Property="Background" Value="#2CFFFFFF" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tarjeta de KPI -->
        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Light.Field}" />
            <Setter Property="BorderBrush" Value="{StaticResource Light.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18,14" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Dark">
                    <Setter Property="Background" Value="{StaticResource Dark.Field}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Brand">
                    <Setter Property="Background" Value="{StaticResource ThemeBrand.Field}" />
                    <Setter Property="BorderBrush" Value="{StaticResource ThemeBrand.Border}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource KpiCard}">
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource HotelSerifFont}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Page}}" />
        </Style>

        <Style x:Key="QuickAction" TargetType="Button" BasedOn="{StaticResource HotelSecondaryButton}">
            <Setter Property="Height" Value="64" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- Botón de texto de la barra (Volver, etc.) -->
        <Style x:Key="BarTextButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#1417384F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#2617384F" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Dark">
                                <Setter TargetName="Surface" Property="Background" Value="Transparent" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Dark" />
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Surface" Property="Background" Value="#1CF6F3ED" />
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Brand">
                                <Setter TargetName="Surface" Property="Background" Value="Transparent" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Brand" />
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Surface" Property="Background" Value="#1CFFFFFF" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Page}}">
        <!-- Capa 1: contenido desplazable -->
        <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False"
                      CanContentScroll="True" ScrollChanged="OnScrollChanged">
            <StackPanel>
                <!-- Espaciador animado: acompaña la altura de la barra -->
                <Border x:Name="TopSpacer" Height="60" />

                <Grid Margin="24,10,24,34">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Encabezado -->
                    <Grid Grid.Row="0" Margin="2,2,2,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Panel principal" Style="{StaticResource HotelSecondaryText}" Margin="0,0,0,4" />
                            <TextBlock FontFamily="{StaticResource HotelSerifFont}" FontSize="28" FontWeight="SemiBold">
                                <Run Text="Buenos días, " /><Run x:Name="GreetingUser" Text="Recepción" FontWeight="Bold" />
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock x:Name="TodayLabel" Text="Sábado, 31 de octubre de 2026" Style="{StaticResource HotelSecondaryText}" />
                                <TextBlock Text="  ·  Turno matutino  ·  Cajero: A. Pérez" Style="{StaticResource HotelSecondaryText}" Margin="0" />
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource KpiCard}" Padding="16,10" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Ocupación" Style="{StaticResource HotelSecondaryText}" FontSize="11" HorizontalAlignment="Center" />
                                <TextBlock Text="82%" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Brand.Gold}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- KPIs -->
                    <ItemsControl Grid.Row="1">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Llegadas hoy" Style="{StaticResource HotelSecondaryText}" FontSize="11" />
                                <TextBlock Text="14" FontSize="24" FontWeight="Bold" Margin="0,2,0,0" />
                                <TextBlock Text="6 pendientes · 8 en camino" Style="{StaticResource HotelSecondaryText}" FontSize="10" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="8,0">
                            <StackPanel>
                                <TextBlock Text="Salidas hoy" Style="{StaticResource HotelSecondaryText}" FontSize="11" />
                                <TextBlock Text="11" FontSize="24" FontWeight="Bold" Margin="0,2,0,0" />
                                <TextBlock Text="3 pendientes · 2 late check-out" Style="{StaticResource HotelSecondaryText}" FontSize="10" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="8,0">
                            <StackPanel>
                                <TextBlock Text="In-house" Style="{StaticResource HotelSecondaryText}" FontSize="11" />
                                <TextBlock Text="96" FontSize="24" FontWeight="Bold" Margin="0,2,0,0" />
                                <TextBlock Text="de 118 habitaciones" Style="{StaticResource HotelSecondaryText}" FontSize="10" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="8,0">
                            <StackPanel>
                                <TextBlock Text="ADR" Style="{StaticResource HotelSecondaryText}" FontSize="11" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="$" FontSize="16" FontWeight="Bold" VerticalAlignment="Bottom" />
                                    <TextBlock Text="148.50" FontSize="24" FontWeight="Bold" />
                                </StackPanel>
                                <TextBlock Text="Tarifa media diaria" Style="{StaticResource HotelSecondaryText}" FontSize="10" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="8,0">
                            <StackPanel>
                                <TextBlock Text="RevPAR" Style="{StaticResource HotelSecondaryText}" FontSize="11" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="$" FontSize="16" FontWeight="Bold" VerticalAlignment="Bottom" />
                                    <TextBlock Text="121.77" FontSize="24" FontWeight="Bold" />
                                </StackPanel>
                                <TextBlock Text="Ingreso por habitación" Style="{StaticResource HotelSecondaryText}" FontSize="10" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Caja turno" Style="{StaticResource HotelSecondaryText}" FontSize="11" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="$" FontSize="16" FontWeight="Bold" VerticalAlignment="Bottom" />
                                    <TextBlock Text="3,920.10" FontSize="24" FontWeight="Bold" />
                                </StackPanel>
                                <TextBlock Text="Abierta · arqueo pendiente" Style="{StaticResource HotelSecondaryText}" FontSize="10" />
                            </StackPanel>
                        </Border>
                    </ItemsControl>

                    <!-- Llegadas y salidas pendientes -->
                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SectionCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Padding="18,14" BorderBrush="{StaticResource Light.Border}" BorderThickness="0,0,0,1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource Light.Border}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Dark">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Brand">
                                                    <Setter Property="BorderBrush" Value="{StaticResource ThemeBrand.Border}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Llegadas pendientes" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                                        <Border Background="#2A17384F" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="6" FontSize="12" FontWeight="Bold" />
                                        </Border>
                                        <TextBlock Text="RF-98" Style="{StaticResource HotelSecondaryText}" FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="6">
                                    <ItemsControl x:Name="ArrivalsList" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Padding="18,14">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource Light.Border}" />
                                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Dark">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Brand">
                                                    <Setter Property="BorderBrush" Value="{StaticResource ThemeBrand.Border}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Salidas pendientes" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                                        <Border Background="#2A17384F" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="3" FontSize="12" FontWeight="Bold" />
                                        </Border>
                                        <TextBlock Text="RF-29" Style="{StaticResource HotelSecondaryText}" FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="6">
                                    <ItemsControl x:Name="DeparturesList" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Accesos rápidos + Alertas -->
                    <Grid Grid.Row="3" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SectionCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Padding="18,14">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource Light.Border}" />
                                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Dark">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Brand">
                                                    <Setter Property="BorderBrush" Value="{StaticResource ThemeBrand.Border}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Accesos rápidos" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <UniformGrid Grid.Row="1" Columns="3" Margin="14,10">
                                    <Button Style="{StaticResource QuickAction}" Tag="Reservas" Click="OnModuleClick" Margin="0,0,6,6">
                                        <StackPanel>
                                            <Path Data="{StaticResource IconReservas}" Width="20" Height="20" Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  HorizontalAlignment="Center" Margin="0,0,0,6" />
                                            <TextBlock Text="Nueva reserva" HorizontalAlignment="Center" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource QuickAction}" Tag="CheckInOut" Click="OnModuleClick" Margin="6,0,0,6">
                                        <StackPanel>
                                            <Path Data="{StaticResource IconCheckInOut}" Width="20" Height="20" Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  HorizontalAlignment="Center" Margin="0,0,0,6" />
                                            <TextBlock Text="Check-in" HorizontalAlignment="Center" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource QuickAction}" Tag="CheckInOut" Click="OnModuleClick" Margin="6,0,0,6">
                                        <StackPanel>
                                            <Path Data="{StaticResource IconCheckInOut}" Width="20" Height="20" Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  HorizontalAlignment="Center" Margin="0,0,0,6" RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <ScaleTransform ScaleX="-1" />
                                                </Path.RenderTransform>
                                            </Path>
                                            <TextBlock Text="Check-out" HorizontalAlignment="Center" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource QuickAction}" Tag="Habitaciones" Click="OnModuleClick" Margin="0,6,6,0">
                                        <StackPanel>
                                            <Path Data="{StaticResource IconHabitaciones}" Width="20" Height="20" Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  HorizontalAlignment="Center" Margin="0,0,0,6" />
                                            <TextBlock Text="Mapa de piso" HorizontalAlignment="Center" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource QuickAction}" Tag="Reportes" Click="OnModuleClick" Margin="6,6,0,0">
                                        <StackPanel>
                                            <Path Data="{StaticResource IconReportes}" Width="20" Height="20" Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  HorizontalAlignment="Center" Margin="0,0,0,6" />
                                            <TextBlock Text="Reporte diario" HorizontalAlignment="Center" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource QuickAction}" Tag="Finanzas" Click="OnModuleClick" Margin="6,6,0,0">
                                        <StackPanel>
                                            <Path Data="{StaticResource IconFinanzas}" Width="20" Height="20" Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  HorizontalAlignment="Center" Margin="0,0,0,6" />
                                            <TextBlock Text="Cerrar caja" HorizontalAlignment="Center" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Padding="18,14">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource Light.Border}" />
                                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Dark">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Brand">
                                                    <Setter Property="BorderBrush" Value="{StaticResource ThemeBrand.Border}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Panel de alertas" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                                        <Border Background="#2A17384F" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="5" FontSize="12" FontWeight="Bold" />
                                        </Border>
                                        <TextBlock Text="RF-95" Style="{StaticResource HotelSecondaryText}" FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="6">
                                    <ItemsControl x:Name="AlertsList" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Estado -->
                    <Border Grid.Row="4" Style="{StaticResource KpiCard}" Margin="0,18,0,0" Padding="18,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource IconAvisos}" Width="22" Height="22" Stretch="Uniform"
                                  Stroke="{StaticResource Brand.Gold}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="StatusTitle" Text="Sincronizado con la nube" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock x:Name="StatusDetail" Text="Última actualización hace 4 s · 4 terminales activas" Style="{StaticResource HotelSecondaryText}" FontSize="11" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" x:Name="ActiveViewLabel" Text="Vista actual: Inicio"
                                       Style="{StaticResource HotelSecondaryText}" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Capa 2: barra de navegación superior (comprimible) -->
        <Border x:Name="TopBar" Height="60" VerticalAlignment="Top"
                MouseEnter="OnBarEnter" MouseLeave="OnBarLeave">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType=Page}}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Light.Border}" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Dark">
                            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Brand">
                            <Setter Property="Background" Value="{StaticResource ThemeBrand.Bar}" />
                            <Setter Property="BorderBrush" Value="#00332B" />
                            <Setter Property="TextElement.Foreground" Value="{StaticResource ThemeBrand.OnBar}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.08" Color="#102B3F" Direction="90" />
            </Border.Effect>
            <DockPanel LastChildFill="True">
                <!-- Botón Volver al login (siempre visible) -->
                <Button x:Name="BackButton" DockPanel.Dock="Left" Click="OnBackClick"
                        Style="{StaticResource BarTextButton}" Margin="10,0,4,0"
                        ToolTip="Volver al inicio de sesión" AutomationProperties.Name="Volver al inicio de sesión">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M11,5 L5,12 L11,19" Width="12" Height="14" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <TextBlock Text="Volver" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <!-- Branding (solo en expandido) -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="6,0,10,0" VerticalAlignment="Center"
                            Visibility="{Binding IsBarExpanded, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}">
                    <ContentControl Width="30" Height="30" Margin="0,0,10,0" Focusable="False" IsTabStop="False"
                                    AutomationProperties.Name="Emblema de Crown &amp; Sovereign"
                                    Template="{StaticResource CrownSovereignLogoTemplate}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Crown &amp; Sovereign" FontFamily="{StaticResource HotelSerifFont}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="PMS · Recepción" Style="{StaticResource HotelSecondaryText}" FontSize="10" />
                    </StackPanel>
                </StackPanel>

                <!-- Acciones: tema siempre visible; avisos/usuario solo en expandido -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,12,0" VerticalAlignment="Center">
                    <Button x:Name="ThemeButton" Click="OnThemeCycle" Style="{StaticResource ThemeCycleButton}" Margin="0"
                            Content="Claro" AutomationProperties.Name="Cambiar tema"
                            ToolTip="Cambiar tema: Claro, Oscuro, Marca" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsBarExpanded, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}">
                        <Button x:Name="BellButton" Style="{StaticResource ModuleNavButton}" Width="38" Height="38" Tag="Avisos"
                                Click="OnModuleClick" ToolTip="Avisos y alertas" AutomationProperties.Name="Avisos" Margin="6,0,0,0">
                            <Grid>
                                <Path Data="{StaticResource IconBell}" Width="18" Height="18" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Ellipse Width="7" Height="7" Fill="#D9534F" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0" />
                            </Grid>
                        </Button>
                        <Border Width="1" Height="26" Margin="12,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource Light.Border}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Dark">
                                            <Setter Property="Background" Value="{StaticResource Dark.Border}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Page}}" Value="Brand">
                                            <Setter Property="Background" Value="#33FFFFFF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="A. Pérez" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            <TextBlock Text="Recepción · Turno 1" Style="{StaticResource HotelSecondaryText}" FontSize="10" HorizontalAlignment="Right" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Módulos -->
                <ItemsControl Margin="2,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <Button Style="{StaticResource ModuleNavButton}" Tag="Inicio" Click="OnModuleClick" ToolTip="Inicio">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconHome}" Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"
                                  Visibility="{Binding IsBarExpanded, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="Inicio" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModuleNavButton}" Tag="Reservas" Click="OnModuleClick" ToolTip="Reservas">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconReservas}" Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"
                                  Visibility="{Binding IsBarExpanded, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="Reservas" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModuleNavButton}" Tag="Habitaciones" Click="OnModuleClick" ToolTip="Habitaciones y housekeeping">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconHabitaciones}" Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"
                                  Visibility="{Binding IsBarExpanded, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="Habitaciones" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModuleNavButton}" Tag="CheckInOut" Click="OnModuleClick" ToolTip="Check-in y check-out">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconCheckInOut}" Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"
                                  Visibility="{Binding IsBarExpanded, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="Check-in/out" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModuleNavButton}" Tag="Huespedes" Click="OnModuleClick" ToolTip="Huéspedes y contactos">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconHuespedes}" Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"
                                  Visibility="{Binding IsBarExpanded, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="Huéspedes" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModuleNavButton}" Tag="Convenios" Click="OnModuleClick" ToolTip="Convenios y transporte">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconConvenios}" Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"
                                  Visibility="{Binding IsBarExpanded, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="Convenios" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModuleNavButton}" Tag="FNB" Click="OnModuleClick" ToolTip="Alimentos y bebidas">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconFNB}" Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"
                                  Visibility="{Binding IsBarExpanded, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="F &amp; B" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModuleNavButton}" Tag="GymSpa" Click="OnModuleClick" ToolTip="Gimnasio y spa">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconGymSpa}" Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"
                                  Visibility="{Binding IsBarExpanded, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="Gym/Spa" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModuleNavButton}" Tag="Lavanderia" Click="OnModuleClick" ToolTip="Lavandería">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconLavanderia}" Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"
                                  Visibility="{Binding IsBarExpanded, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="Lavandería" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModuleNavButton}" Tag="Finanzas" Click="OnModuleClick" ToolTip="Financiero y facturación">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconFinanzas}" Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"
                                  Visibility="{Binding IsBarExpanded, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="Finanzas" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModuleNavButton}" Tag="Reportes" Click="OnModuleClick" ToolTip="Reportes">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconReportes}" Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"
                                  Visibility="{Binding IsBarExpanded, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="Reportes" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModuleNavButton}" Tag="Config" Click="OnModuleClick" ToolTip="Configuración y administración">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconConfig}" Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"
                                  Visibility="{Binding IsBarExpanded, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="Ajustes" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </ItemsControl>
            </DockPanel>
        </Border>
    </Grid>
</Page>
