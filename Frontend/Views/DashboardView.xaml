<Page x:Class="Crown__.Frontend.Views.DashboardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d" d:DesignWidth="1172" d:DesignHeight="702"
      Title="Crown &amp; Sovereign — Operaciones" FontFamily="{StaticResource HotelSansFont}"
      Background="{DynamicResource Ui.Page}" Foreground="{DynamicResource Ui.Ink}"
      UseLayoutRounding="True" SnapsToDevicePixels="True"
      Loaded="OnDashboardLoaded" PreviewKeyDown="OnPageKeyDown">
    <Page.Resources>
        <SolidColorBrush x:Key="Ui.Page" Color="#FAF9F6" />
        <SolidColorBrush x:Key="Ui.Ink" Color="#192F40" />
        <SolidColorBrush x:Key="Ui.Secondary" Color="#5D6872" />
        <SolidColorBrush x:Key="Ui.Field" Color="White" />
        <SolidColorBrush x:Key="Ui.Border" Color="#B8BFC5" />
        <SolidColorBrush x:Key="Ui.Soft" Color="#EDF0F2" />
        <SolidColorBrush x:Key="Ui.Primary" Color="#17384F" />
        <SolidColorBrush x:Key="Ui.OnPrimary" Color="White" />
        <SolidColorBrush x:Key="Ui.Focus" Color="#8A682C" />
        <SolidColorBrush x:Key="Ui.Good" Color="#276447" />
        <SolidColorBrush x:Key="Ui.Warning" Color="#805C1C" />
        <SolidColorBrush x:Key="Ui.Danger" Color="#AE3535" />
        <SolidColorBrush x:Key="Ui.Nav" Color="#17384F" />
        <SolidColorBrush x:Key="Ui.NavSelected" Color="#31566D" />
        <SolidColorBrush x:Key="Ui.NavInk" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Ui.NavMuted" Color="#C1D0DB" />
        <SolidColorBrush x:Key="Ui.NavAccent" Color="#D9BB79" />
        <SolidColorBrush x:Key="Ui.Selection" Color="#D9BB79" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Ui.Ink}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource Ui.Secondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Ui.Field}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ui.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Ui.Ink}" />
            <Setter Property="Background" Value="{DynamicResource Ui.Field}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ui.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Ui.Focus}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.76" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Ui.Focus}" />
                                <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource Ui.OnPrimary}" />
            <Setter Property="Background" Value="{DynamicResource Ui.Primary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ui.Primary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Botón de menú lateral con esquinas redondeadas modernas y estado activo claro -->
        <Style x:Key="Nav" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Ui.NavInk}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12" />
                            <Border x:Name="HoverOverlay" Background="#16FFFFFF" CornerRadius="12" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="ActiveBar" Width="3.5" Height="18" CornerRadius="2"
                                    Background="{DynamicResource Ui.NavAccent}" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Margin="5,0,0,0" Visibility="Collapsed" IsHitTestVisible="False" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <Border x:Name="FocusRing" BorderBrush="{DynamicResource Ui.NavAccent}"
                                    BorderThickness="2" CornerRadius="12" Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="FontWeight" Value="SemiBold">
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#2EFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Input de texto con hint aislado: se oculta al enfocar o al existir cualquier carácter -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Ui.Ink}" />
            <Setter Property="Background" Value="{DynamicResource Ui.Field}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ui.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource Ui.Ink}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Ui.Selection}" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MaxLength" Value="180" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="FieldBorder" CornerRadius="10"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="0"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Focusable="False" />
                            <TextBlock x:Name="Placeholder"
                                       Text="{TemplateBinding Tag}"
                                       Margin="14,0"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       Foreground="{DynamicResource Ui.Secondary}"
                                       Opacity="0.68"
                                       FontSize="{TemplateBinding FontSize}"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value="" />
                                    <Condition Property="IsKeyboardFocusWithin" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </MultiTrigger>
                            <Trigger Property="AcceptsReturn" Value="True">
                                <Setter TargetName="Placeholder" Property="Margin" Value="14,10" />
                                <Setter TargetName="Placeholder" Property="TextWrapping" Value="Wrap" />
                                <Setter TargetName="Placeholder" Property="TextTrimming" Value="None" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource Ui.Focus}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource Ui.Focus}" />
                                <Setter TargetName="FieldBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FieldBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="AcceptsReturn" Value="True">
                    <Setter Property="Padding" Value="12,10" />
                    <Setter Property="VerticalContentAlignment" Value="Top" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Ui.Ink}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Item" Background="{TemplateBinding Background}" CornerRadius="9" Margin="4,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Item" Property="Background" Value="{DynamicResource Ui.Soft}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Item" Property="Background" Value="{DynamicResource Ui.Soft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Ui.Ink}" />
            <Setter Property="Background" Value="{DynamicResource Ui.Field}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ui.Border}" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Box" CornerRadius="12" Background="{DynamicResource Ui.Field}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1">
                                            <Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource Ui.Ink}" StrokeThickness="1.5" Width="8" Height="4" HorizontalAlignment="Right" Margin="0,0,14,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Ui.Focus}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              IsHitTestVisible="False" VerticalAlignment="Center" Margin="14,0,34,0" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
                                <Border Background="{DynamicResource Ui.Field}" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="1" CornerRadius="14" Padding="2,4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                            <Border x:Name="Focus" BorderBrush="{DynamicResource Ui.Focus}" BorderThickness="2" CornerRadius="12" Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ThemeOptionTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="8" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="1" Margin="0,0,12,0" ClipToBounds="True" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{Binding NavBrush}" />
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="{Binding SurfaceBrush}" />
                            <Border Grid.Row="1" Background="{Binding AccentBrush}" />
                        </Grid>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Ui.Ink}" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource Ui.Secondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style TargetType="CheckBox" BasedOn="{StaticResource HotelCheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource Ui.Ink}" />
            <Setter Property="Margin" Value="0,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Grip" Background="{DynamicResource Ui.Border}" CornerRadius="4" Margin="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="{DynamicResource Ui.Secondary}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="{DynamicResource Ui.Focus}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="Decrease" Command="ScrollBar.PageUpCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="Increase" Command="ScrollBar.PageDownCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="Height" Value="8" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                <Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand" />
                                <Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="8" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Grip" Background="#36FFFFFF" CornerRadius="3" Margin="1" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="#68FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid x:Name="Workspace">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="218" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Menú lateral redondeado y moderno -->
            <Border Background="{DynamicResource Ui.Nav}" CornerRadius="22" Margin="2,2,0,4"
                    Padding="13,18,13,14" BorderBrush="#24FFFFFF" BorderThickness="1">
                <Border.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="6" />
                        <Setter Property="MinWidth" Value="6" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="Transparent">
                                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                                    <RepeatButton.Template>
                                                        <ControlTemplate TargetType="RepeatButton">
                                                            <Border Background="Transparent" />
                                                        </ControlTemplate>
                                                    </RepeatButton.Template>
                                                </RepeatButton>
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource NavScrollThumb}" />
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                                    <RepeatButton.Template>
                                                        <ControlTemplate TargetType="RepeatButton">
                                                            <Border Background="Transparent" />
                                                        </ControlTemplate>
                                                    </RepeatButton.Template>
                                                </RepeatButton>
                                            </Track.IncreaseRepeatButton>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Resources>
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Top" Margin="6,2,4,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="43" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl Template="{StaticResource CrownSovereignLogoTemplate}" Width="35" Height="35" VerticalAlignment="Top" Margin="0,3,0,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Crown &amp;&#10;Sovereign" Foreground="{DynamicResource Ui.NavInk}" FontFamily="{StaticResource HotelSerifFont}" FontSize="16" FontWeight="Bold" />
                            <TextBlock Text="Gestión hotelera" Foreground="{DynamicResource Ui.NavMuted}" FontSize="12" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Border Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="14" Padding="12,10" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock x:Name="RoleName" Text="Personal" Foreground="{DynamicResource Ui.NavInk}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Puesto de demostración" Foreground="{DynamicResource Ui.NavMuted}" FontSize="11" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="ThemeButton" Click="OnThemeCycle" Content="Tema: Claro" Style="{StaticResource Nav}" ToolTip="Cambiar tema (Alt+T)" AutomationProperties.Name="Cambiar tema" />
                        <Button x:Name="BackToLoginButton" Content="Volver al acceso" Click="OnBackClick" Style="{StaticResource Nav}" Margin="0,2,0,0" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="NavigationItems" Margin="0,0,2,0" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="24,22,20,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="OfflineBanner" Grid.Row="0" Visibility="Collapsed"
                        Background="{DynamicResource Ui.Soft}" BorderBrush="{DynamicResource Ui.Danger}"
                        BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Sin conexión con la nube (RNF-02)" FontWeight="SemiBold" Foreground="{DynamicResource Ui.Danger}" />
                            <TextBlock Text="Las operaciones críticas están bloqueadas temporalmente para proteger la integridad de datos; tus borradores en pantalla se conservan." Style="{StaticResource Muted}" FontSize="12" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Restablecer red" Click="OnRestoreNetworkClick" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="PageDescription" Style="{StaticResource Muted}" Margin="0,7,18,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Border x:Name="CloudStatusBadge" Background="{DynamicResource Ui.Soft}" BorderBrush="{DynamicResource Ui.Border}"
                                BorderThickness="1" CornerRadius="10" Padding="11,8" Margin="0,0,8,0" VerticalAlignment="Center"
                                ToolTip="Estado de conexión con Supabase en la nube (RNF-02 / RNF-03)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="CloudStatusDot" Width="8" Height="8" Fill="{DynamicResource Ui.Good}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="CloudStatusText" Text="Nube conectada" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Button Content="Ayuda (F1)" Click="OnHelpClick" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="ContentScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ModuleContent" Margin="0,0,8,16" />
                </ScrollViewer>
                <Border Grid.Row="3" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                    <TextBlock x:Name="SessionNotice" Text="Demostración con datos de muestra. Los borradores no se guardan." Style="{StaticResource Muted}" FontSize="11" />
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="Overlay" Visibility="Collapsed" Background="#80000000" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
            <Border Style="{StaticResource Panel}" CornerRadius="20" Width="540" MaxHeight="560" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="DialogTitle" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="DialogDescription" Style="{StaticResource Muted}" Margin="0,6,12,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Click="OnCloseDialog" ToolTip="Cerrar (Esc)" AutomationProperties.Name="Cerrar panel" Width="38" Padding="8" VerticalAlignment="Top">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" Width="10" Height="10" StrokeThickness="1.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DialogBody" Margin="0,0,8,0" />
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <TextBlock x:Name="DialogError" Foreground="{DynamicResource Ui.Danger}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cerrar" Click="OnCloseDialog" Margin="0,0,8,0" />
                            <Button x:Name="DialogSubmit" Content="Revisar borrador" Click="OnReviewDraft" Style="{StaticResource Primary}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
