<Window x:Class="Crown__.Frontend.Views.Dialogs.NuevaReservaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nueva reserva" Width="480" Height="470"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Background="{DynamicResource UI.Page}" TextElement.Foreground="{DynamicResource UI.Text}">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16">
        <TextBlock Text="Huésped principal" />
        <ComboBox />
        <TextBlock Text="Canal" />
        <ComboBox />
        <TextBlock Text="Entrada" />
        <DatePicker />
        <TextBlock Text="Salida" />
        <DatePicker />
        <TextBlock Text="Personas" />
        <TextBox />
        <TextBlock Text="Habitación" />
        <ComboBox />
        <TextBlock Text="Tarifa por noche" />
        <TextBox />
        <TextBlock Text="Observaciones" />
        <TextBox Height="50" AcceptsReturn="True" />
    </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Margin="16,8,16,12" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Click="OnCancelar" />
            <Button Content="Guardar" IsDefault="True" Click="OnGuardar" />
        </StackPanel>
    </Grid>
</Window>
