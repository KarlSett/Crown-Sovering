<Window x:Class="Crown__.Frontend.Views.Dialogs.NuevaReservaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nueva reserva" Width="480" Height="470"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Huésped principal" />
        <ComboBox x:Name="CmbHuesped" />
        <TextBlock Text="Canal" />
        <ComboBox x:Name="CmbCanal" />
        <TextBlock Text="Entrada" />
        <DatePicker x:Name="DpEntrada" SelectedDateChanged="OnFechasCambian" />
        <TextBlock Text="Salida" />
        <DatePicker x:Name="DpSalida" SelectedDateChanged="OnFechasCambian" />
        <TextBlock Text="Personas" />
        <TextBox x:Name="TxtPersonas" Text="1" />
        <TextBlock Text="Habitación" />
        <ComboBox x:Name="CmbHabitacion" SelectionChanged="OnHabitacion" />
        <TextBlock Text="Tarifa por noche" />
        <TextBox x:Name="TxtTarifa" IsReadOnly="True" />
        <TextBlock Text="Observaciones" />
        <TextBox x:Name="TxtObservaciones" Height="50" AcceptsReturn="True" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Click="OnCancelar" />
            <Button Content="Guardar" IsDefault="True" Click="OnGuardar" />
        </StackPanel>
    </StackPanel>
</Window>
