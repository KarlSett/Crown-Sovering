<Window x:Class="Crown__.Frontend.Views.Dialogs.NuevaHabitacionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nueva habitación" Width="420" Height="330"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Número" />
        <TextBox />
        <TextBlock Text="Piso" />
        <ComboBox />
        <TextBlock Text="Tipo de habitación" />
        <ComboBox />
        <TextBlock Text="Estado" />
        <ComboBox />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Click="OnCancelar" />
            <Button Content="Guardar" IsDefault="True" Click="OnGuardar" />
        </StackPanel>
    </StackPanel>
</Window>
