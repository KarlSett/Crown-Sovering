<Window x:Class="Crown__.Frontend.Views.Dialogs.NuevaHabitacionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nueva habitación" Width="420" Height="330"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Background="{DynamicResource UI.Page}" TextElement.Foreground="{DynamicResource UI.Text}">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16">
        <TextBlock Text="Número" />
        <TextBox />
        <TextBlock Text="Piso" />
        <ComboBox />
        <TextBlock Text="Tipo de habitación" />
        <ComboBox />
        <TextBlock Text="Estado" />
        <ComboBox />
    </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Margin="16,8,16,12" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Click="OnCancelar" />
            <Button Content="Guardar" IsDefault="True" Click="OnGuardar" />
        </StackPanel>
    </Grid>
</Window>
