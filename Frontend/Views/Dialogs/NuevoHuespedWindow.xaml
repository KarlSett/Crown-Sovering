<Window x:Class="Crown__.Frontend.Views.Dialogs.NuevoHuespedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Huésped" Width="440" Height="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Nombre" />
        <TextBox x:Name="TxtNombre" />
        <TextBlock Text="Apellidos" />
        <TextBox x:Name="TxtApellidos" />
        <TextBlock Text="Documento (por ejemplo CI 7001234)" />
        <TextBox x:Name="TxtDocumento" />
        <TextBlock Text="Correo" />
        <TextBox x:Name="TxtCorreo" />
        <TextBlock Text="Teléfono" />
        <TextBox x:Name="TxtTelefono" />
        <TextBlock Text="Fecha de nacimiento" />
        <DatePicker x:Name="DpNacimiento" />
        <CheckBox x:Name="ChkConsentimiento" Content="Autoriza el tratamiento de datos" />
        <TextBlock x:Name="TxtError" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Click="OnCancelar" />
            <Button Content="Guardar" IsDefault="True" Click="OnGuardar" />
        </StackPanel>
    </StackPanel>
</Window>
