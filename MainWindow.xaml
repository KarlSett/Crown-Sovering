<Window x:Class="Crown__.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Crown &amp; Sovereign — Sistema hotelero"
        Width="1200" Height="760" MinWidth="920" MinHeight="660"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource HotelSansFont}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6"
                            CornerRadius="28" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource Light.Page}" />
            <Setter Property="Foreground" Value="{StaticResource Light.Ink}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Content.Tag, ElementName=LoginFrame}" Value="Dark">
                    <Setter Property="Background" Value="{StaticResource Dark.Page}" />
                    <Setter Property="Foreground" Value="{StaticResource Dark.Ink}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>
    <Window.Resources>
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#1817384F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#3017384F" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Brand.Gold}" />
                                <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Crown &amp; Sovereign" FontSize="12" FontWeight="Medium"
                   VerticalAlignment="Center" Margin="24,0,200,0" Opacity="0.7" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0">
            <Button Click="MinimizeWindow" Style="{StaticResource WindowButton}"
                    ToolTip="Minimizar" AutomationProperties.Name="Minimizar ventana" IsTabStop="False">
                <Path Data="M0,5 H10" Width="10" Height="10" StrokeThickness="1"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Button Click="ToggleMaximizeWindow" Style="{StaticResource WindowButton}"
                    ToolTip="Maximizar o restaurar" AutomationProperties.Name="Maximizar o restaurar ventana" IsTabStop="False">
                <Path Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Width="10" Height="10" StrokeThickness="1"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Button Click="CloseWindow" Style="{StaticResource WindowButton}" Width="78"
                    ToolTip="Salir del programa" AutomationProperties.Name="Salir del programa" KeyboardNavigation.TabIndex="8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M0,0 L10,10 M10,0 L0,10" Width="10" Height="10" StrokeThickness="1.2"
                          VerticalAlignment="Center"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <TextBlock Text="Salir" FontSize="12" Margin="9,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
        <Frame x:Name="LoginFrame" Grid.Row="1" Margin="14,0,14,14"
               Source="Frontend/Views/LoginView.xaml" NavigationUIVisibility="Hidden"
               Focusable="False" BorderThickness="0" Background="Transparent" />
    </Grid>
</Window>